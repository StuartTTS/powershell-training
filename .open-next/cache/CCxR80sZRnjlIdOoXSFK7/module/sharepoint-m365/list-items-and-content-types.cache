{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/module/layout,_N_T_/module/[moduleSlug]/layout,_N_T_/module/[moduleSlug]/[lessonSlug]/layout,_N_T_/module/[moduleSlug]/[lessonSlug]/page,_N_T_/module/sharepoint-m365/list-items-and-content-types"},"segmentPaths":["/_tree","/_full","/module/$d$moduleSlug/$d$lessonSlug/__PAGE__","/module/$d$moduleSlug/$d$lessonSlug","/module/$d$moduleSlug","/module","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en\" class=\"geist_a71539c9-module__T19VSG__variable geist_mono_8d43a2aa-module__8Li5zG__variable h-full antialiased dark\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/797e433ab948586e-s.p.0.q-h669a_dqa.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/caa3a2e1cccd8315-s.p.16t1db8_9y2o~.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0-7zhabl4g7ue.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/0jhb9jzfymubw.js\"/><script src=\"/_next/static/chunks/0tszvp5wpnn-t.js\" async=\"\"></script><script src=\"/_next/static/chunks/01284-0uqzklw.js\" async=\"\"></script><script src=\"/_next/static/chunks/0bogtdbh.dcu1.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0z.wwd4fghi_a.js\" async=\"\"></script><script src=\"/_next/static/chunks/01xlw8hd842-c.js\" async=\"\"></script><script src=\"/_next/static/chunks/0d3shmwh5_nmn.js\" async=\"\"></script><script src=\"/_next/static/chunks/0xv9uz7g8af6d.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>PowerShell Training</title><meta name=\"description\" content=\"Interactive PowerShell training — from basics to SharePoint administration.\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.0x3dzn~oxb6tn.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/03~yq9q893hmn.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col bg-zinc-950 text-zinc-100\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"min-h-screen bg-zinc-950 text-zinc-100\"><header class=\"sticky top-0 z-10 border-b border-zinc-800/60 bg-zinc-950/80 backdrop-blur-xl\"><div class=\"mx-auto flex max-w-4xl items-center justify-between px-6 py-3.5\"><a class=\"inline-flex items-center gap-1.5 text-sm text-zinc-500 transition-colors hover:text-zinc-300\" href=\"/module/sharepoint-m365/\"><svg class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18\"></path></svg>SharePoint &amp; M365 PowerShell</a><div class=\"flex items-center gap-2\"><a class=\"flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-800 text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-200\" title=\"Managing Site Permissions\" href=\"/module/sharepoint-m365/site-permissions/\"><svg class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15.75 19.5L8.25 12l7.5-7.5\"></path></svg></a><span class=\"text-xs tabular-nums text-zinc-500\">4<!-- --> / <!-- -->8</span><a class=\"flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-800 text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-200\" title=\"Managing Teams and Groups\" href=\"/module/sharepoint-m365/teams-and-groups/\"><svg class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M8.25 4.5l7.5 7.5-7.5 7.5\"></path></svg></a></div></div><div class=\"mx-auto max-w-4xl px-6 pb-4\"><h1 class=\"text-2xl font-bold tracking-tight\">List Items and Content Types</h1></div></header><main class=\"mx-auto max-w-4xl px-6 py-10\"><div class=\"mb-6 flex items-center gap-2.5 rounded-lg border border-amber-500/20 bg-amber-500/5 px-4 py-2.5 text-sm text-amber-300/90\"><svg class=\"h-4 w-4 shrink-0\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z\"></path></svg>Progress tracking unavailable in this browser mode.</div><div class=\"max-w-none\"><h1 class=\"mb-4 mt-10 text-[28px] font-bold tracking-tight text-zinc-50 first:mt-0\">List Items and Content Types</h1><p class=\"mb-4 text-[15px] leading-[1.7] text-zinc-300/90\">SharePoint lists store rows of data called <strong class=\"font-semibold text-zinc-100\">list items</strong>. Each item has fields (columns) that hold values. PnP PowerShell gives you full CRUD (Create, Read, Update, Delete) control over list items.</p><h2 class=\"mb-3 mt-8 text-xl font-semibold tracking-tight text-zinc-100\">Reading List Items</h2><p class=\"mb-4 text-[15px] leading-[1.7] text-zinc-300/90\">Retrieve all items from a list:</p><div class=\"group my-5 overflow-hidden rounded-xl border border-zinc-700/30 bg-[#0c0c0f]\"><div class=\"flex items-center justify-between border-b border-zinc-800/60 bg-zinc-900/40 px-4 py-2\"><span class=\"text-xs font-medium text-zinc-500\">powershell</span><button class=\"flex items-center gap-1.5 rounded-md px-2 py-1 text-xs text-zinc-500 opacity-0 transition-all hover:bg-zinc-800 hover:text-zinc-300 group-hover:opacity-100\"><svg class=\"h-3.5 w-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184\"></path></svg>Copy</button></div><pre class=\"overflow-x-auto px-5 py-4\"><code class=\"text-[13px] leading-[1.7] text-zinc-200\">Get-PnPListItem -List &quot;Projects&quot;</code></pre></div><p class=\"mb-4 text-[15px] leading-[1.7] text-zinc-300/90\">For large lists, use a CAML query with the <code class=\"rounded-md bg-zinc-800/80 px-1.5 py-0.5 text-[13px] font-medium text-blue-300/90\">-Query</code> parameter to filter server-side and improve performance:</p><div class=\"group my-5 overflow-hidden rounded-xl border border-zinc-700/30 bg-[#0c0c0f]\"><div class=\"flex items-center justify-between border-b border-zinc-800/60 bg-zinc-900/40 px-4 py-2\"><span class=\"text-xs font-medium text-zinc-500\">powershell</span><button class=\"flex items-center gap-1.5 rounded-md px-2 py-1 text-xs text-zinc-500 opacity-0 transition-all hover:bg-zinc-800 hover:text-zinc-300 group-hover:opacity-100\"><svg class=\"h-3.5 w-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184\"></path></svg>Copy</button></div><pre class=\"overflow-x-auto px-5 py-4\"><code class=\"text-[13px] leading-[1.7] text-zinc-200\">$query = &quot;&lt;View&gt;&lt;Query&gt;&lt;Where&gt;\n    &lt;Eq&gt;&lt;FieldRef Name=&#x27;Status&#x27;/&gt;&lt;Value Type=&#x27;Text&#x27;&gt;Active&lt;/Value&gt;&lt;/Eq&gt;\n&lt;/Where&gt;&lt;/Query&gt;&lt;/View&gt;&quot;\n\nGet-PnPListItem -List &quot;Projects&quot; -Query $query</code></pre></div><div class=\"my-5 flex gap-3 rounded-xl border px-5 py-4 border-blue-500/15 bg-blue-500/5\"><div class=\"mt-0.5 shrink-0\"><svg class=\"h-5 w-5 text-blue-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18\"></path></svg></div><p class=\"text-[15px] leading-relaxed text-blue-100/90\"><strong class=\"font-semibold text-zinc-100\">Key Concept:</strong> CAML (Collaborative Application Markup Language) is SharePoint&#x27;s XML-based query language. Using <code class=\"rounded-md bg-zinc-800/80 px-1.5 py-0.5 text-[13px] font-medium text-blue-300/90\">-Query</code> filters data on the server, which is far more efficient than retrieving all items and filtering locally with <code class=\"rounded-md bg-zinc-800/80 px-1.5 py-0.5 text-[13px] font-medium text-blue-300/90\">Where-Object</code>.</p></div><h2 class=\"mb-3 mt-8 text-xl font-semibold tracking-tight text-zinc-100\">Adding New Items</h2><p class=\"mb-4 text-[15px] leading-[1.7] text-zinc-300/90\">Create a new list item by passing a hashtable of field values:</p><div class=\"group my-5 overflow-hidden rounded-xl border border-zinc-700/30 bg-[#0c0c0f]\"><div class=\"flex items-center justify-between border-b border-zinc-800/60 bg-zinc-900/40 px-4 py-2\"><span class=\"text-xs font-medium text-zinc-500\">powershell</span><button class=\"flex items-center gap-1.5 rounded-md px-2 py-1 text-xs text-zinc-500 opacity-0 transition-all hover:bg-zinc-800 hover:text-zinc-300 group-hover:opacity-100\"><svg class=\"h-3.5 w-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184\"></path></svg>Copy</button></div><pre class=\"overflow-x-auto px-5 py-4\"><code class=\"text-[13px] leading-[1.7] text-zinc-200\">Add-PnPListItem -List &quot;Projects&quot; -Values @{\n    Title       = &quot;Website Redesign&quot;\n    Status      = &quot;Active&quot;\n    Priority    = &quot;High&quot;\n}</code></pre></div><h2 class=\"mb-3 mt-8 text-xl font-semibold tracking-tight text-zinc-100\">Updating Items</h2><p class=\"mb-4 text-[15px] leading-[1.7] text-zinc-300/90\">Update an existing item by its ID:</p><div class=\"group my-5 overflow-hidden rounded-xl border border-zinc-700/30 bg-[#0c0c0f]\"><div class=\"flex items-center justify-between border-b border-zinc-800/60 bg-zinc-900/40 px-4 py-2\"><span class=\"text-xs font-medium text-zinc-500\">powershell</span><button class=\"flex items-center gap-1.5 rounded-md px-2 py-1 text-xs text-zinc-500 opacity-0 transition-all hover:bg-zinc-800 hover:text-zinc-300 group-hover:opacity-100\"><svg class=\"h-3.5 w-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184\"></path></svg>Copy</button></div><pre class=\"overflow-x-auto px-5 py-4\"><code class=\"text-[13px] leading-[1.7] text-zinc-200\">Set-PnPListItem -List &quot;Projects&quot; -Identity 5 -Values @{\n    Status = &quot;Completed&quot;\n}</code></pre></div><h2 class=\"mb-3 mt-8 text-xl font-semibold tracking-tight text-zinc-100\">Deleting Items</h2><p class=\"mb-4 text-[15px] leading-[1.7] text-zinc-300/90\">Remove a list item by ID. Use <code class=\"rounded-md bg-zinc-800/80 px-1.5 py-0.5 text-[13px] font-medium text-blue-300/90\">-Force</code> to skip confirmation:</p><div class=\"group my-5 overflow-hidden rounded-xl border border-zinc-700/30 bg-[#0c0c0f]\"><div class=\"flex items-center justify-between border-b border-zinc-800/60 bg-zinc-900/40 px-4 py-2\"><span class=\"text-xs font-medium text-zinc-500\">powershell</span><button class=\"flex items-center gap-1.5 rounded-md px-2 py-1 text-xs text-zinc-500 opacity-0 transition-all hover:bg-zinc-800 hover:text-zinc-300 group-hover:opacity-100\"><svg class=\"h-3.5 w-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184\"></path></svg>Copy</button></div><pre class=\"overflow-x-auto px-5 py-4\"><code class=\"text-[13px] leading-[1.7] text-zinc-200\">Remove-PnPListItem -List &quot;Projects&quot; -Identity 5 -Force</code></pre></div><h2 class=\"mb-3 mt-8 text-xl font-semibold tracking-tight text-zinc-100\">Content Types</h2><p class=\"mb-4 text-[15px] leading-[1.7] text-zinc-300/90\">Content types define reusable sets of columns and behaviors. View available content types with:</p><div class=\"group my-5 overflow-hidden rounded-xl border border-zinc-700/30 bg-[#0c0c0f]\"><div class=\"flex items-center justify-between border-b border-zinc-800/60 bg-zinc-900/40 px-4 py-2\"><span class=\"text-xs font-medium text-zinc-500\">powershell</span><button class=\"flex items-center gap-1.5 rounded-md px-2 py-1 text-xs text-zinc-500 opacity-0 transition-all hover:bg-zinc-800 hover:text-zinc-300 group-hover:opacity-100\"><svg class=\"h-3.5 w-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184\"></path></svg>Copy</button></div><pre class=\"overflow-x-auto px-5 py-4\"><code class=\"text-[13px] leading-[1.7] text-zinc-200\">Get-PnPContentType</code></pre></div><p class=\"mb-4 text-[15px] leading-[1.7] text-zinc-300/90\">To see content types specific to a list:</p><div class=\"group my-5 overflow-hidden rounded-xl border border-zinc-700/30 bg-[#0c0c0f]\"><div class=\"flex items-center justify-between border-b border-zinc-800/60 bg-zinc-900/40 px-4 py-2\"><span class=\"text-xs font-medium text-zinc-500\">powershell</span><button class=\"flex items-center gap-1.5 rounded-md px-2 py-1 text-xs text-zinc-500 opacity-0 transition-all hover:bg-zinc-800 hover:text-zinc-300 group-hover:opacity-100\"><svg class=\"h-3.5 w-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184\"></path></svg>Copy</button></div><pre class=\"overflow-x-auto px-5 py-4\"><code class=\"text-[13px] leading-[1.7] text-zinc-200\">Get-PnPContentType -List &quot;Projects&quot;</code></pre></div><h2 class=\"mb-3 mt-8 text-xl font-semibold tracking-tight text-zinc-100\">Adding Content Types to Lists</h2><p class=\"mb-4 text-[15px] leading-[1.7] text-zinc-300/90\">Apply an existing site content type to a list:</p><div class=\"group my-5 overflow-hidden rounded-xl border border-zinc-700/30 bg-[#0c0c0f]\"><div class=\"flex items-center justify-between border-b border-zinc-800/60 bg-zinc-900/40 px-4 py-2\"><span class=\"text-xs font-medium text-zinc-500\">powershell</span><button class=\"flex items-center gap-1.5 rounded-md px-2 py-1 text-xs text-zinc-500 opacity-0 transition-all hover:bg-zinc-800 hover:text-zinc-300 group-hover:opacity-100\"><svg class=\"h-3.5 w-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184\"></path></svg>Copy</button></div><pre class=\"overflow-x-auto px-5 py-4\"><code class=\"text-[13px] leading-[1.7] text-zinc-200\">Add-PnPContentTypeToList -List &quot;Projects&quot; `\n    -ContentType &quot;Document&quot; -DefaultContentType</code></pre></div><div class=\"my-5 flex gap-3 rounded-xl border px-5 py-4 border-blue-500/15 bg-blue-500/5\"><div class=\"mt-0.5 shrink-0\"><svg class=\"h-5 w-5 text-blue-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18\"></path></svg></div><p class=\"text-[15px] leading-relaxed text-blue-100/90\"><strong class=\"font-semibold text-zinc-100\">Key Concept:</strong> The <code class=\"rounded-md bg-zinc-800/80 px-1.5 py-0.5 text-[13px] font-medium text-blue-300/90\">-DefaultContentType</code> switch makes the added content type the default for new items. Without it, the content type is available but not pre-selected when users create items.</p></div></div><div class=\"mt-12 border-t border-zinc-800/60 pt-10\"><div class=\"mb-6 flex items-center justify-between\"><div class=\"flex items-center gap-3\"><h2 class=\"text-xl font-semibold tracking-tight\">Exercises</h2><div class=\"rounded-full bg-zinc-800/80 px-2.5 py-0.5 text-xs font-medium text-zinc-400\">0<!-- -->/<!-- -->4<!-- --> completed</div></div></div><div class=\"mb-6\"><div class=\"h-1 w-full overflow-hidden rounded-full bg-zinc-800/80\"><div class=\"h-full rounded-full bg-gradient-to-r from-blue-500 to-emerald-500 transition-all duration-500 ease-out\" style=\"width:0%\"></div></div></div><div class=\"mb-6 flex flex-wrap gap-2\"><button class=\"relative flex h-9 w-9 items-center justify-center rounded-lg text-sm font-medium transition-all bg-blue-600 text-white shadow-md shadow-blue-500/25 ring-2 ring-blue-500/30 ring-offset-1 ring-offset-zinc-950\">1</button><button class=\"relative flex h-9 w-9 items-center justify-center rounded-lg text-sm font-medium transition-all bg-zinc-800/60 text-zinc-500 hover:bg-zinc-800 hover:text-zinc-300\">2</button><button class=\"relative flex h-9 w-9 items-center justify-center rounded-lg text-sm font-medium transition-all bg-zinc-800/60 text-zinc-500 hover:bg-zinc-800 hover:text-zinc-300\">3</button><button class=\"relative flex h-9 w-9 items-center justify-center rounded-lg text-sm font-medium transition-all bg-zinc-800/60 text-zinc-500 hover:bg-zinc-800 hover:text-zinc-300\">4</button></div><div class=\"overflow-hidden rounded-xl border border-zinc-800/80 bg-gradient-to-b from-zinc-900 to-zinc-900/80 shadow-2xl shadow-black/20\"><div class=\"border-b border-zinc-800/60 bg-zinc-900/50 px-6 py-4\"><div class=\"flex items-start gap-3\"><div class=\"mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-blue-500/10 text-blue-400\"><svg class=\"h-3.5 w-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z\"></path></svg></div><p class=\"text-[15px] leading-relaxed text-zinc-200\">Write a CAML query command to get items from the &#x27;Tickets&#x27; list where the Priority field equals &#x27;High&#x27;. Store the CAML XML in a $query variable, then pass it to Get-PnPListItem.</p></div></div><div class=\"px-6 pt-4 pb-2\"><div class=\"overflow-hidden rounded-lg border border-zinc-700/50 bg-[#0c0c0f]\"><!--$!--><template data-dgst=\"BAILOUT_TO_CLIENT_SIDE_RENDERING\"></template><div class=\"flex items-center justify-center h-[160px] bg-[#0c0c0f] text-zinc-500 text-sm rounded-lg border border-zinc-700/50\"><div class=\"flex items-center gap-2\"><div class=\"h-4 w-4 animate-spin rounded-full border-2 border-zinc-600 border-t-blue-500\"></div>Loading editor...</div></div><!--/$--></div></div><div class=\"flex items-center gap-2.5 px-6 py-3\"><button disabled=\"\" class=\"inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm shadow-blue-500/20 transition-all hover:bg-blue-500 hover:shadow-blue-500/30 active:scale-[0.98] disabled:opacity-40 disabled:shadow-none disabled:hover:bg-blue-600\"><svg class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z\"></path></svg>Check Answer</button><button class=\"inline-flex items-center gap-1.5 rounded-lg border border-zinc-700/60 bg-zinc-800/50 px-3.5 py-2 text-sm font-medium text-zinc-300 transition-all hover:border-zinc-600 hover:bg-zinc-700/50 hover:text-zinc-200 disabled:opacity-30\"><svg class=\"h-3.5 w-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18\"></path></svg>Hint</button></div><div class=\"h-2\"></div></div></div></main><footer class=\"border-t border-zinc-800/60\"><div class=\"mx-auto flex max-w-4xl items-center justify-between px-6 py-6\"><a class=\"group flex items-center gap-2 text-sm text-zinc-400 transition-colors hover:text-zinc-200\" href=\"/module/sharepoint-m365/site-permissions/\"><svg class=\"h-4 w-4 transition-transform group-hover:-translate-x-0.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18\"></path></svg>Managing Site Permissions</a><a class=\"group flex items-center gap-2 text-sm text-zinc-400 transition-colors hover:text-zinc-200\" href=\"/module/sharepoint-m365/teams-and-groups/\">Managing Teams and Groups<svg class=\"h-4 w-4 transition-transform group-hover:translate-x-0.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" 