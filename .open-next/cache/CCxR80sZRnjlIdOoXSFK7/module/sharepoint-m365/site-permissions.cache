\"name\":\"Next.Metadata\",\"children\":\"$Lc\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}],false]],\"m\":\"$undefined\",\"G\":[\"$d\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0-7zhabl4g7ue.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]]],\"S\":true,\"h\":null,\"s\":\"$undefined\",\"l\":\"$undefined\",\"p\":\"$undefined\",\"d\":\"$undefined\",\"b\":\"CCxR80sZRnjlIdOoXSFK7\"}\ne:[]\n8:\"$We\"\nf:I[22016,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"/_next/static/chunks/0xv9uz7g8af6d.js\"],\"\"]\n10:I[16505,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"/_next/static/chunks/0xv9uz7g8af6d.js\"],\"LessonClient\"]\n11:T96b,# Managing Site Permissions\n\nSharePoint permissions control who can view, edit, and manage site content. PnP PowerShell lets you manage groups, members, and sharing settings programmatically.\n\n## Viewing Site Groups\n\nEvery SharePoint site has default groups (Owners, Members, Visitors). List them all with:\n\n```powershell\nGet-PnPSiteGroup\n```\n\nTo see details for a specific group, including its permission roles:\n\n```powershell\nGet-PnPSiteGroup -Group \"Contoso Members\"\n```\n\n## Setting Group Permissions\n\nChange the permission level assigned to a group using `Set-PnPGroupPermissions`:\n\n```powershell\nSet-PnPGroupPermissions -Identity \"Contoso Visitors\" `\n    -AddRole \"Edit\" -RemoveRole \"Read\"\n```\n\n> **Key Concept:** SharePoint uses **permission levels** like Full Control, Edit, Contribute, and Read. These levels are collections of individual permissions. You assign levels to groups, then add users to groups.\n\n## Adding Members to Groups\n\nAdd users to an existing SharePoint group:\n\n```powershell\nAdd-PnPGroupMember -Group \"Contoso Members\" `\n    -LoginName \"user@contoso.com\"\n```\n\nYou can also add multiple users by repeating the command or piping a list of email addresses through a `ForEach-Object` loop.\n\n## Breaking Permission Inheritance\n\nBy default, subsites and lists inherit permissions from their parent. You can break this inheritance to set unique permissions:\n\n```powershell\nSet-PnPList -Identity \"Confidential Docs\" -BreakRoleInheritance\n```\n\nAfter breaking inheritance, the list keeps a copy of its parent permissions. You can then modify them independently.\n\n## Site Design Rights\n\nIf you create custom site designs, you can grant specific users the right to apply them:\n\n```powershell\nGrant-PnPSiteDesignRights -Identity \"YOUR-SITE-DESIGN-ID\" `\n    -Principals \"user@contoso.com\" -Rights View\n```\n\n## External Sharing\n\nControl whether a site allows sharing with people outside your organization:\n\n```powershell\n# Check current sharing capability\nGet-PnPSite -Includes SharingCapability\n\n# Set sharing level using Set-PnPSite\nSet-PnPSite -Identity \"https://contoso.sharepoint.com/sites/HR\" `\n    -SharingCapability ExternalUserSharingOnly\n```\n\n> **Key Concept:** Sharing levels range from `Disabled` (no external sharing) to `ExternalUserAndGuestSharing` (most permissive). Tenant-level settings override site-level settings, so your site cannot be more permissive than the tenant allows.\n4:[\"$\",\"div\",null,{\"className\":\"min-h-screen bg-zinc-950 text-zinc-100\",\"children\":[[\"$\",\"header\",null,{\"className\":\"sticky top-0 z-10 border-b border-zinc-800/60 bg-zinc-950/80 backdrop-blur-xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto flex max-w-4xl items-center justify-between px-6 py-3.5\",\"children\":[[\"$\",\"$Lf\",null,{\"href\":\"/module/sharepoint-m365\",\"className\":\"inline-flex items-center gap-1.5 text-sm text-zinc-500 transition-colors hover:text-zinc-300\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-4 w-4\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"strokeWidth\":2,\"stroke\":\"currentColor\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18\"}]}],\"SharePoint & M365 PowerShell\"]}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2\",\"children\":[[\"$\",\"$Lf\",null,{\"href\":\"/module/sharepoint-m365/sharepoint-sites-and-lists\",\"className\":\"flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-800 text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-200\",\"title\":\"Managing SharePoint Sites and Lists\",\"children\":[\"$\",\"svg\",null,{\"className\":\"h-4 w-4\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"strokeWidth\":2,\"stroke\":\"currentColor\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M15.75 19.5L8.25 12l7.5-7.5\"}]}]}],[\"$\",\"span\",null,{\"className\":\"text-xs tabular-nums text-zinc-500\",\"children\":[3,\" / \",8]}],[\"$\",\"$Lf\",null,{\"href\":\"/module/sharepoint-m365/list-items-and-content-types\",\"className\":\"flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-800 text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-200\",\"title\":\"List Items and Content Types\",\"children\":[\"$\",\"svg\",null,{\"className\":\"h-4 w-4\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"strokeWidth\":2,\"stroke\":\"currentColor\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M8.25 4.5l7.5 7.5-7.5 7.5\"}]}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-4xl px-6 pb-4\",\"children\":[\"$\",\"h1\",null,{\"className\":\"text-2xl font-bold tracking-tight\",\"children\":\"Managing Site Permissions\"}]}]]}],[\"$\",\"$L10\",null,{\"lesson\":{\"meta\":{\"title\":\"Managing Site Permissions\",\"description\":\"Permissions and sharing in SharePoint.\",\"slug\":\"site-permissions\",\"order\":3,\"prerequisites\":[\"m3-l2\"]},\"content\":\"$11\",\"exercises\":[{\"id\":\"m3-l3-ex1\",\"type\":\"syntax-check\",\"prompt\":\"Write the command to list all SharePoint site groups on the current site.\",\"hints\":[\"PnP PowerShell has a cmdlet specifically for site groups.\",\"The verb is Get and the noun starts with PnP.\",\"Try: Get-PnPSiteGroup\"],\"validation\":[{\"rule\":\"contains\",\"value\":\"Get-PnPSiteGroup\",\"hintOnFail\":\"Use the Get-PnPSiteGroup cmdlet.\"}],\"solution\":\"Get-PnPSiteGroup\",\"explanation\":\"Get-PnPSiteGroup returns all SharePoint groups associated with the current site, including Owners, Members, and Visitors.\"},{\"id\":\"m3-l3-ex2\",\"type\":\"syntax-check\",\"prompt\":\"Write the command to add the user 'jane@contoso.com' to the 'Project Owners' group.\",\"hints\":[\"Use Add-PnPGroupMember to add users to groups.\",\"The -Group parameter specifies which group.\",\"The -LoginName parameter specifies the user.\"],\"validation\":[{\"rule\":\"contains\",\"value\":\"Add-PnPGroupMember\",\"hintOnFail\":\"Use the Add-PnPGroupMember cmdlet.\"},{\"rule\":\"regex\",\"pattern\":\"-Group\\\\s+[\\\"']Project Owners[\\\"']\",\"hintOnFail\":\"Specify -Group \\\"Project Owners\\\".\"},{\"rule\":\"regex\",\"pattern\":\"-LoginName\\\\s+[\\\"']?jane@contoso\\\\.com[\\\"']?\",\"hintOnFail\":\"Specify -LoginName \\\"jane@contoso.com\\\".\"}],\"solution\":\"Add-PnPGroupMember -Group \\\"Project Owners\\\" -LoginName \\\"jane@contoso.com\\\"\",\"explanation\":\"Add-PnPGroupMember adds a user to a SharePoint group. The -LoginName accepts the user's email address or UPN.\"},{\"id\":\"m3-l3-ex3\",\"type\":\"syntax-check\",\"prompt\":\"Write the command to change the 'Interns' group permissions by adding the 'Read' role and removing the 'Edit' role.\",\"hints\":[\"Use Set-PnPGroupPermissions to modify group permissions.\",\"The -Identity parameter identifies the group.\",\"Use -AddRole and -RemoveRole to change permission levels.\"],\"validation\":[{\"rule\":\"contains\",\"value\":\"Set-PnPGroupPermissions\",\"hintOnFail\":\"Use the Set-PnPGroupPermissions cmdlet.\"},{\"rule\":\"regex\",\"pattern\":\"-Identity\\\\s+[\\\"']?Interns[\\\"']?\",\"hintOnFail\":\"Specify the group with -Identity \\\"Interns\\\".\"},{\"rule\":\"regex\",\"pattern\":\"-AddRole\\\\s+[\\\"']?Read[\\\"']?\",\"hintOnFail\":\"Add the Read role with -AddRole \\\"Read\\\".\"},{\"rule\":\"regex\",\"pattern\":\"-RemoveRole\\\\s+[\\\"']?Edit[\\\"']?\",\"hintOnFail\":\"Remove the Edit role with -RemoveRole \\\"Edit\\\".\"}],\"solution\":\"Set-PnPGroupPermissions -Identity \\\"Interns\\\" -AddRole \\\"Read\\\" -RemoveRole \\\"Edit\\\"\",\"explanation\":\"Set-PnPGroupPermissions changes the permission levels assigned to a group. -AddRole grants a permission level while -RemoveRole revokes one.\"},{\"id\":\"m3-l3-ex4\",\"type\":\"syntax-check\",\"prompt\":\"Write the command to grant the user 'admin@contoso.com' View rights to a site design with ID 'abc-123-def'.\",\"hints\":[\"Use Grant-PnPSiteDesignRights to grant site design rights.\",\"The -Identity parameter takes the site design ID.\",\"Use -Principals for the user and -Rights for the access level.\"],\"validation\":[{\"rule\":\"contains\",\"value\":\"Grant-PnPSiteDesignRights\",\"hintOnFail\":\"Use the Grant-PnPSiteDesignRights cmdlet.\"},{\"rule\":\"regex\",\"pattern\":\"-Identity\\\\s+[\\\"']?abc-123-def[\\\"']?\",\"hintOnFail\":\"Set -Identity to the site design ID 'abc-123-def'.\"},{\"rule\":\"regex\",\"pattern\":\"-Principals\\\\s+[\\\"']?admin@contoso\\\\.com[\\\"']?\",\"hintOnFail\":\"Set -Principals to 'admin@contoso.com'.\"},{\"rule\":\"regex\",\"pattern\":\"-Rights\\\\s+View\",\"hintOnFail\":\"Set -Rights to View.\"}],\"solution\":\"Grant-PnPSiteDesignRights -Identity \\\"abc-123-def\\\" -Principals \\\"admin@contoso.com\\\" -Rights View\",\"explanation\":\"Grant-PnPSiteDesignRights controls who can see and apply custom site designs. The -Rights View parameter lets the specified user use the design when creating sites.\"}],\"moduleSlug\":\"sharepoint-m365\"}}],\"$L12\"]}]\n12: