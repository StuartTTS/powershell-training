\\\":[null,[\\\"$\\\",\\\"$L9\\\",null,{\\\"children\\\":\\\"$La\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$Lb\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$6\\\",null,{\\\"name\\\":\\\"Next.Metadata\\\",\\\"children\\\":\\\"$Lc\\\"}]}]}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]]}],false]],\\\"m\\\":\\\"$undefined\\\",\\\"G\\\":[\\\"$d\\\",[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/0-7zhabl4g7ue.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]]],\\\"S\\\":true,\\\"h\\\":null,\\\"s\\\":\\\"$undefined\\\",\\\"l\\\":\\\"$undefined\\\",\\\"p\\\":\\\"$undefined\\\",\\\"d\\\":\\\"$undefined\\\",\\\"b\\\":\\\"CCxR80sZRnjlIdOoXSFK7\\\"}\\n\"])</script><script>self.__next_f.push([1,\"e:[]\\n8:\\\"$We\\\"\\n\"])</script><script>self.__next_f.push([1,\"f:I[22016,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\",\\\"/_next/static/chunks/0xv9uz7g8af6d.js\\\"],\\\"\\\"]\\n10:I[16505,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\",\\\"/_next/static/chunks/0xv9uz7g8af6d.js\\\"],\\\"LessonClient\\\"]\\n11:T8dc,\"])</script><script>self.__next_f.push([1,\"# Managing SharePoint Sites and Lists\\n\\nOnce connected with `Connect-PnPOnline`, you can create and manage SharePoint sites, lists, and columns entirely from PowerShell.\\n\\n## Getting Site Information\\n\\nRetrieve details about the site you are connected to:\\n\\n```powershell\\nGet-PnPSite                   # Returns the site collection object\\nGet-PnPWeb                    # Returns the current web (subsite) object\\nGet-PnPWeb | Select-Object Title, Url, Language\\n```\\n\\n\\u003e **Key Concept:** In SharePoint, a **site collection** (returned by `Get-PnPSite`) is the top-level container. A **web** (returned by `Get-PnPWeb`) is an individual site or subsite within that collection.\\n\\n## Creating New Sites\\n\\nUse `New-PnPSite` to create communication or team sites. The `-Type` parameter controls which kind:\\n\\n```powershell\\n# Communication site\\nNew-PnPSite -Type CommunicationSite -Title \\\"Company News\\\" `\\n    -Url \\\"https://contoso.sharepoint.com/sites/CompanyNews\\\"\\n\\n# Team site (backed by an M365 Group)\\nNew-PnPSite -Type TeamSite -Title \\\"Engineering\\\" -Alias \\\"Engineering\\\"\\n```\\n\\nCommunication sites are for broadcasting content. Team sites are collaboration spaces tied to a Microsoft 365 Group.\\n\\n## Working with Lists\\n\\nLists are the core data structure in SharePoint. Retrieve, create, and remove them with these cmdlets:\\n\\n```powershell\\n# Get all lists on the current site\\nGet-PnPList\\n\\n# Get a specific list by title\\nGet-PnPList -Identity \\\"Projects\\\"\\n\\n# Create a new generic list\\nNew-PnPList -Title \\\"Inventory\\\" -Template GenericList\\n\\n# Create a document library\\nNew-PnPList -Title \\\"Proposals\\\" -Template DocumentLibrary\\n```\\n\\n## Adding Columns (Fields)\\n\\nAfter creating a list, add custom columns with `Add-PnPField`:\\n\\n```powershell\\nAdd-PnPField -List \\\"Inventory\\\" -DisplayName \\\"SKU\\\" `\\n    -InternalName \\\"SKU\\\" -Type Text\\n\\nAdd-PnPField -List \\\"Inventory\\\" -DisplayName \\\"Quantity\\\" `\\n    -InternalName \\\"Quantity\\\" -Type Number\\n```\\n\\n\\u003e **Key Concept:** Always specify both `-DisplayName` (what users see) and `-InternalName` (used in code and queries). The internal name cannot be changed after creation, so choose it carefully.\\n\\n## Removing a List\\n\\nTo delete a list, use `Remove-PnPList`. Add `-Force` to skip the confirmation prompt:\\n\\n```powershell\\nRemove-PnPList -Identity \\\"Inventory\\\" -Force\\n```\\n\"])</script><script>self.__next_f.push([1,\"4:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"min-h-screen bg-zinc-950 text-zinc-100\\\",\\\"children\\\":[[\\\"$\\\",\\\"header\\\",null,{\\\"className\\\":\\\"sticky top-0 z-10 border-b border-zinc-800/60 bg-zinc-950/80 backdrop-blur-xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto flex max-w-4xl items-center justify-between px-6 py-3.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/sharepoint-m365\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 text-sm text-zinc-500 transition-colors hover:text-zinc-300\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"strokeWidth\\\":2,\\\"stroke\\\":\\\"currentColor\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18\\\"}]}],\\\"SharePoint \\u0026 M365 PowerShell\\\"]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/sharepoint-m365/connecting-to-m365\\\",\\\"className\\\":\\\"flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-800 text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-200\\\",\\\"title\\\":\\\"Connecting to M365\\\",\\\"children\\\":[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"strokeWidth\\\":2,\\\"stroke\\\":\\\"currentColor\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M15.75 19.5L8.25 12l7.5-7.5\\\"}]}]}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-xs tabular-nums text-zinc-500\\\",\\\"children\\\":[2,\\\" / \\\",8]}],[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/sharepoint-m365/site-permissions\\\",\\\"className\\\":\\\"flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-800 text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-200\\\",\\\"title\\\":\\\"Managing Site Permissions\\\",\\\"children\\\":[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"strokeWidth\\\":2,\\\"stroke\\\":\\\"currentColor\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M8.25 4.5l7.5 7.5-7.5 7.5\\\"}]}]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-4xl px-6 pb-4\\\",\\\"children\\\":[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"text-2xl font-bold tracking-tight\\\",\\\"children\\\":\\\"Managing SharePoint Sites and Lists\\\"}]}]]}],[\\\"$\\\",\\\"$L10\\\",null,{\\\"lesson\\\":{\\\"meta\\\":{\\\"title\\\":\\\"Managing SharePoint Sites and Lists\\\",\\\"description\\\":\\\"Creating and managing sites and lists.\\\",\\\"slug\\\":\\\"sharepoint-sites-and-lists\\\",\\\"order\\\":2,\\\"prerequisites\\\":[\\\"m3-l1\\\"]},\\\"content\\\":\\\"$11\\\",\\\"exercises\\\":[{\\\"id\\\":\\\"m3-l2-ex1\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Write a command to get the current SharePoint web and display only its Title and Url properties.\\\",\\\"hints\\\":[\\\"Start with Get-PnPWeb to get the current web object.\\\",\\\"Pipe to Select-Object to choose specific properties.\\\",\\\"The properties to select are Title and Url.\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Get-PnPWeb\\\",\\\"hintOnFail\\\":\\\"Use Get-PnPWeb to retrieve the current web.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"|\\\",\\\"hintOnFail\\\":\\\"Pipe the result using | to another cmdlet.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Select-Object\\\",\\\"hintOnFail\\\":\\\"Use Select-Object to choose which properties to display.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Title\\\",\\\"hintOnFail\\\":\\\"Include the Title property.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Url\\\",\\\"hintOnFail\\\":\\\"Include the Url property.\\\"}],\\\"solution\\\":\\\"Get-PnPWeb | Select-Object Title, Url\\\",\\\"explanation\\\":\\\"Get-PnPWeb returns the current web object. Piping to Select-Object Title, Url filters the output to show only those two properties.\\\"},{\\\"id\\\":\\\"m3-l2-ex2\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Write the command to create a new team site with the title 'Marketing' and the alias 'Marketing'.\\\",\\\"hints\\\":[\\\"Use New-PnPSite to create sites.\\\",\\\"The -Type parameter should be TeamSite.\\\",\\\"Team sites use -Alias instead of -Url.\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"New-PnPSite\\\",\\\"hintOnFail\\\":\\\"Use the New-PnPSite cmdlet.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"-Type\\\\\\\\s+TeamSite\\\",\\\"hintOnFail\\\":\\\"Specify -Type TeamSite to create a team site.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"-Title\\\\\\\\s+[\\\\\\\"']?Marketing[\\\\\\\"']?\\\",\\\"hintOnFail\\\":\\\"Set the -Title to 'Marketing'.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"-Alias\\\\\\\\s+[\\\\\\\"']?Marketing[\\\\\\\"']?\\\",\\\"hintOnFail\\\":\\\"Set the -Alias to 'Marketing'.\\\"}],\\\"solution\\\":\\\"New-PnPSite -Type TeamSite -Title \\\\\\\"Marketing\\\\\\\" -Alias \\\\\\\"Marketing\\\\\\\"\\\",\\\"explanation\\\":\\\"New-PnPSite -Type TeamSite creates a team site backed by a Microsoft 365 Group. The -Alias sets the group email prefix and site URL path.\\\"},{\\\"id\\\":\\\"m3-l2-ex3\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Write the command to create a new SharePoint list called 'Tasks' using the GenericList template.\\\",\\\"hints\\\":[\\\"Use New-PnPList to create lists.\\\",\\\"The -Title parameter sets the list name.\\\",\\\"The -Template parameter specifies the list type.\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"New-PnPList\\\",\\\"hintOnFail\\\":\\\"Use the New-PnPList cmdlet.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"-Title\\\\\\\\s+[\\\\\\\"']?Tasks[\\\\\\\"']?\\\",\\\"hintOnFail\\\":\\\"Set the -Title to 'Tasks'.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"-Template\\\\\\\\s+GenericList\\\",\\\"hintOnFail\\\":\\\"Specify -Template GenericList.\\\"}],\\\"solution\\\":\\\"New-PnPList -Title \\\\\\\"Tasks\\\\\\\" -Template GenericList\\\",\\\"explanation\\\":\\\"New-PnPList creates a new list on the connected SharePoint site. GenericList creates a standard custom list with a Title column.\\\"},{\\\"id\\\":\\\"m3-l2-ex4\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Write the command to add a text column called 'Department' (internal name 'Department') to the 'Tasks' list.\\\",\\\"hints\\\":[\\\"Use Add-PnPField to add columns.\\\",\\\"Specify the list with -List.\\\",\\\"Set -DisplayName, -InternalName, and -Type.\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Add-PnPField\\\",\\\"hintOnFail\\\":\\\"Use the Add-PnPField cmdlet.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"-List\\\\\\\\s+[\\\\\\\"']?Tasks[\\\\\\\"']?\\\",\\\"hintOnFail\\\":\\\"Specify -List \\\\\\\"Tasks\\\\\\\" to target the Tasks list.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"-DisplayName\\\\\\\\s+[\\\\\\\"']?Department[\\\\\\\"']?\\\",\\\"hintOnFail\\\":\\\"Set -DisplayName to 'Department'.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"-InternalName\\\\\\\\s+[\\\\\\\"']?Department[\\\\\\\"']?\\\",\\\"hintOnFail\\\":\\\"Set -InternalName to 'Department'.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"-Type\\\\\\\\s+Text\\\",\\\"hintOnFail\\\":\\\"Set -Type to Text for a text column.\\\"}],\\\"solution\\\":\\\"Add-PnPField -List \\\\\\\"Tasks\\\\\\\" -DisplayName \\\\\\\"Department\\\\\\\" -InternalName \\\\\\\"Department\\\\\\\" -Type Text\\\",\\\"explanation\\\":\\\"Add-PnPField adds a new column to an existing list. The -InternalName is used in code and CAML queries, while -DisplayName is what users see in the browser.\\\"}],\\\"moduleSlug\\\":\\\"sharepoint-m365\\\"}}],\\\"$L12\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"12:[\\\"$\\\",\\\"footer\\\",null,{\\\"className\\\":\\\"border-t border-zinc-800/60\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto flex max-w-4xl items-center justify-between px-6 py-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/sharepoint-m365/connecting-to-m365\\\",\\\"className\\\":\\\"group flex items-center gap-2 text-sm text-zinc-400 transition-colors hover:text-zinc-200\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4 transition-transform group-hover:-translate-x-0.5\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"strokeWidth\\\":2,\\\"stroke\\\":\\\"currentColor\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18\\\"}]}],\\\"Connecting to M365\\\"]}],[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/sharepoint-m365/site-permissions\\\",\\\"className\\\":\\\"group flex items-center gap-2 text-sm text-zinc-400 transition-colors hover:text-zinc-200\\\",\\\"children\\\":[\\\"Managing Site Permissions\\\",[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4 transition-transform group-hover:translate-x-0.5\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"strokeWidth\\\":2,\\\"stroke\\\":\\\"currentColor\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3\\\"}]}]]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"a:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\