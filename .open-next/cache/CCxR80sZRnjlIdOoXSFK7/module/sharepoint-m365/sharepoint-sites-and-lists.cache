ttern\":\"-Type\\\\s+TeamSite\",\"hintOnFail\":\"Specify -Type TeamSite to create a team site.\"},{\"rule\":\"regex\",\"pattern\":\"-Title\\\\s+[\\\"']?Marketing[\\\"']?\",\"hintOnFail\":\"Set the -Title to 'Marketing'.\"},{\"rule\":\"regex\",\"pattern\":\"-Alias\\\\s+[\\\"']?Marketing[\\\"']?\",\"hintOnFail\":\"Set the -Alias to 'Marketing'.\"}],\"solution\":\"New-PnPSite -Type TeamSite -Title \\\"Marketing\\\" -Alias \\\"Marketing\\\"\",\"explanation\":\"New-PnPSite -Type TeamSite creates a team site backed by a Microsoft 365 Group. The -Alias sets the group email prefix and site URL path.\"},{\"id\":\"m3-l2-ex3\",\"type\":\"syntax-check\",\"prompt\":\"Write the command to create a new SharePoint list called 'Tasks' using the GenericList template.\",\"hints\":[\"Use New-PnPList to create lists.\",\"The -Title parameter sets the list name.\",\"The -Template parameter specifies the list type.\"],\"validation\":[{\"rule\":\"contains\",\"value\":\"New-PnPList\",\"hintOnFail\":\"Use the New-PnPList cmdlet.\"},{\"rule\":\"regex\",\"pattern\":\"-Title\\\\s+[\\\"']?Tasks[\\\"']?\",\"hintOnFail\":\"Set the -Title to 'Tasks'.\"},{\"rule\":\"regex\",\"pattern\":\"-Template\\\\s+GenericList\",\"hintOnFail\":\"Specify -Template GenericList.\"}],\"solution\":\"New-PnPList -Title \\\"Tasks\\\" -Template GenericList\",\"explanation\":\"New-PnPList creates a new list on the connected SharePoint site. GenericList creates a standard custom list with a Title column.\"},{\"id\":\"m3-l2-ex4\",\"type\":\"syntax-check\",\"prompt\":\"Write the command to add a text column called 'Department' (internal name 'Department') to the 'Tasks' list.\",\"hints\":[\"Use Add-PnPField to add columns.\",\"Specify the list with -List.\",\"Set -DisplayName, -InternalName, and -Type.\"],\"validation\":[{\"rule\":\"contains\",\"value\":\"Add-PnPField\",\"hintOnFail\":\"Use the Add-PnPField cmdlet.\"},{\"rule\":\"regex\",\"pattern\":\"-List\\\\s+[\\\"']?Tasks[\\\"']?\",\"hintOnFail\":\"Specify -List \\\"Tasks\\\" to target the Tasks list.\"},{\"rule\":\"regex\",\"pattern\":\"-DisplayName\\\\s+[\\\"']?Department[\\\"']?\",\"hintOnFail\":\"Set -DisplayName to 'Department'.\"},{\"rule\":\"regex\",\"pattern\":\"-InternalName\\\\s+[\\\"']?Department[\\\"']?\",\"hintOnFail\":\"Set -InternalName to 'Department'.\"},{\"rule\":\"regex\",\"pattern\":\"-Type\\\\s+Text\",\"hintOnFail\":\"Set -Type to Text for a text column.\"}],\"solution\":\"Add-PnPField -List \\\"Tasks\\\" -DisplayName \\\"Department\\\" -InternalName \\\"Department\\\" -Type Text\",\"explanation\":\"Add-PnPField adds a new column to an existing list. The -InternalName is used in code and CAML queries, while -DisplayName is what users see in the browser.\"}],\"moduleSlug\":\"sharepoint-m365\"}}],\"$L5\"]}],[\"$L6\"],\"$L7\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"CCxR80sZRnjlIdOoXSFK7\"}\n5:[\"$\",\"footer\",null,{\"className\":\"border-t border-zinc-800/60\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto flex max-w-4xl items-center justify-between px-6 py-6\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/module/sharepoint-m365/connecting-to-m365\",\"className\":\"group flex items-center gap-2 text-sm text-zinc-400 transition-colors hover:text-zinc-200\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 transition-transform group-hover:-translate-x-0.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"strokeWidth\":2,\"stroke\":\"currentColor\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18\"}]}],\"Connecting to M365\"]}],[\"$\",\"$L2\",null,{\"href\":\"/module/sharepoint-m365/site-permissions\",\"className\":\"group flex items-center gap-2 text-sm text-zinc-400 transition-colors hover:text-zinc-200\",\"children\":[\"Managing Site Permissions\",[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 transition-transform group-hover:translate-x-0.5\",\"fill\":\"none\",\"viewBox\":\"