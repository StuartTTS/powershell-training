g\":\"sharepoint-sites-and-lists\",\"order\":2,\"prerequisites\":[\"m3-l1\"]},\"content\":\"$11\",\"exercises\":[{\"id\":\"m3-l2-ex1\",\"type\":\"syntax-check\",\"prompt\":\"Write a command to get the current SharePoint web and display only its Title and Url properties.\",\"hints\":[\"Start with Get-PnPWeb to get the current web object.\",\"Pipe to Select-Object to choose specific properties.\",\"The properties to select are Title and Url.\"],\"validation\":[{\"rule\":\"contains\",\"value\":\"Get-PnPWeb\",\"hintOnFail\":\"Use Get-PnPWeb to retrieve the current web.\"},{\"rule\":\"contains\",\"value\":\"|\",\"hintOnFail\":\"Pipe the result using | to another cmdlet.\"},{\"rule\":\"contains\",\"value\":\"Select-Object\",\"hintOnFail\":\"Use Select-Object to choose which properties to display.\"},{\"rule\":\"contains\",\"value\":\"Title\",\"hintOnFail\":\"Include the Title property.\"},{\"rule\":\"contains\",\"value\":\"Url\",\"hintOnFail\":\"Include the Url property.\"}],\"solution\":\"Get-PnPWeb | Select-Object Title, Url\",\"explanation\":\"Get-PnPWeb returns the current web object. Piping to Select-Object Title, Url filters the output to show only those two properties.\"},{\"id\":\"m3-l2-ex2\",\"type\":\"syntax-check\",\"prompt\":\"Write the command to create a new team site with the title 'Marketing' and the alias 'Marketing'.\",\"hints\":[\"Use New-PnPSite to create sites.\",\"The -Type parameter should be TeamSite.\",\"Team sites use -Alias instead of -Url.\"],\"validation\":[{\"rule\":\"contains\",\"value\":\"New-PnPSite\",\"hintOnFail\":\"Use the New-PnPSite cmdlet.\"},{\"rule\":\"regex\",\"pattern\":\"-Type\\\\s+TeamSite\",\"hintOnFail\":\"Specify -Type TeamSite to create a team site.\"},{\"rule\":\"regex\",\"pattern\":\"-Title\\\\s+[\\\"']?Marketing[\\\"']?\",\"hintOnFail\":\"Set the -Title to 'Marketing'.\"},{\"rule\":\"regex\",\"pattern\":\"-Alias\\\\s+[\\\"']?Marketing[\\\"']?\",\"hintOnFail\":\"Set the -Alias to 'Marketing'.\"}],\"solution\":\"New-PnPSite -Type TeamSite -Title \\\"Marketing\\\" -Alias \\\"Marketing\\\"\",\"explanation\":\"New-PnPSite -Type TeamSite creates a team site backed by a Microsoft 365 Group. The -Alias sets the group email prefix and site URL path.\"},{\"id\":\"m3-l2-ex3\",\"type\":\"syntax-check\",\"prompt\":\"Write the command to create a new SharePoint list called 'Tasks' using the GenericList template.\",\"hints\":[\"Use New-PnPList to create lists.\",\"The -Title parameter sets the list name.\",\"The -Template parameter specifies the list type.\"],\"validation\":[{\"rule\":\"contains\",\"value\":\"New-PnPList\",\"hintOnFail\":\"Use the New-PnPList cmdlet.\"},{\"rule\":\"regex\",\"pattern\":\"-Title\\\\s+[\\\"']?Tasks[\\\"']?\",\"hintOnFail\":\"Set the -Title to 'Tasks'.\"},{\"rule\":\"regex\",\"pattern\":\"-Template\\\\s+GenericList\",\"hintOnFail\":\"Specify -Template GenericList.\"}],\"solution\":\"New-PnPList -Title \\\"Tasks\\\" -Template GenericList\",\"explanation\":\"New-PnPList creates a new list on the connected SharePoint site. GenericList creates a standard custom list with a Title column.\"},{\"id\":\"m3-l2-ex4\",\"type\":\"syntax-check\",\"prompt\":\"Write the command to add a text column called 'Department' (internal name 'Department') to the 'Tasks' list.\",\"hints\":[\"Use Add-PnPField to add columns.\",\"Specify the list with -List.\",\"Set -DisplayName, -InternalName, and -Type.\"],\"validation\":[{\"rule\":\"contains\",\"value\":\"Add-PnPField\",\"hintOnFail\":\"Use the Add-PnPField cmdlet.\"},{\"rule\":\"regex\",\"pattern\":\"-List\\\\s+[\\\"']?Tasks[\\\"']?\",\"hintOnFail\":\"Specify -List \\\"Tasks\\\" to target the Tasks list.\"},{\"rule\":\"regex\",\"pattern\":\"-DisplayName\\\\s+[\\\"']?Department[\\\"']?\",\"hintOnFail\":\"Set -DisplayName to 'Department'.\"},{\"rule\":\"regex\",\"pattern\":\"-InternalName\\\\s+[\\\"']?Department[\\\"']?\",\"hintOnFail\":\"Set -InternalName to 'Department'.\"},{\"rule\":\"regex\",\"pattern\":\"-Type\\\\s+Text\",\"hintOnFail\":\"Set -Type to Text for a text column.\"}],\"solution\":\"Add-PnPField -List \\\"Tasks\\\" -DisplayName \\\"Department\\\" -InternalName \\\"Department\\\" -Type Text\",\"explanation\":\"Add-PnPField adds a new column to an existing list. The -InternalName is used in code and CAML queries, while -DisplayName is what users see in the browser.\"}],\"moduleSlug\":\"sharepoint-m365\"}}],\"$L12\"]}]\n12:[\"$\",\"footer\",null,{\"className\":\"border-t border-zinc-800/60\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto flex max-w-4xl items-center justify-between px-6 py-6\",\"children\":[[\"$\",\"$Lf\",null,{\"href\":\"/module/sharepoint-m365/connecting-to-m365\",\"className\":\"group flex items-center gap-2 text-sm text-zinc-400 transition-colors hover:text-zinc-200\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 transition-transform group-hover:-translate-x-0.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"strokeWidth\":2,\"stroke\":\"currentColor\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18\"}]}],\"Connecting to M365\"]}],[\"$\",\"$Lf\",null,{\"href\":\"/module/sharepoint-m365/site-permissions\",\"className\":\"group flex items-center gap-2 text-sm text-zinc-400 transition-colors hover:text-zinc-200\",\"children\":[\"Managing Site Permissions\",[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 transition-transform group-hover:translate-x-0.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"strokeWidth\":2,\"stroke\":\"currentColor\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3\"}]}]]}]]}]}]\na:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n13:I[27201,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"IconMark\"]\n7:null\nc:[[\"$\"