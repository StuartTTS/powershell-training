:[\\\"$\\\",\\\"$6\\\",null,{\\\"name\\\":\\\"Next.MetadataOutlet\\\",\\\"children\\\":\\\"$@7\\\"}]}]]}],{},null,false,null]},null,false,\\\"$@8\\\"]},null,false,\\\"$@8\\\"]},null,false,\\\"$@8\\\"]},null,false,null],[\\\"$\\\",\\\"$1\\\",\\\"h\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L9\\\",null,{\\\"children\\\":\\\"$La\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$Lb\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$6\\\",null,{\\\"name\\\":\\\"Next.Metadata\\\",\\\"children\\\":\\\"$Lc\\\"}]}]}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]]}],false]],\\\"m\\\":\\\"$undefined\\\",\\\"G\\\":[\\\"$d\\\",[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/0-7zhabl4g7ue.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]]],\\\"S\\\":true,\\\"h\\\":null,\\\"s\\\":\\\"$undefined\\\",\\\"l\\\":\\\"$undefined\\\",\\\"p\\\":\\\"$undefined\\\",\\\"d\\\":\\\"$undefined\\\",\\\"b\\\":\\\"CCxR80sZRnjlIdOoXSFK7\\\"}\\n\"])</script><script>self.__next_f.push([1,\"e:[]\\n8:\\\"$We\\\"\\n\"])</script><script>self.__next_f.push([1,\"f:I[22016,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\",\\\"/_next/static/chunks/0xv9uz7g8af6d.js\\\"],\\\"\\\"]\\n10:I[16505,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\",\\\"/_next/static/chunks/0xv9uz7g8af6d.js\\\"],\\\"LessonClient\\\"]\\n11:T83d,\"])</script><script>self.__next_f.push([1,\"# Strings, Arrays, and Hashtables\\n\\nThese three data structures form the backbone of everyday PowerShell scripting.\\n\\n## Strings: Single vs Double Quotes\\n\\n**Double quotes** expand variables and escape sequences. **Single quotes** treat everything as literal text:\\n\\n```powershell\\n$name = \\\"Alice\\\"\\n\\\"Hello, $name!\\\"    # Hello, Alice!\\n'Hello, $name!'    # Hello, $name!\\n```\\n\\nUse `$()` inside double quotes to evaluate expressions:\\n\\n```powershell\\n\\\"There are $($items.Count) items.\\\"\\n```\\n\\n\\u003e **Key Concept:** Use single quotes when you want the exact literal string. Use double quotes when you need variable expansion or special characters like `` `n `` (newline).\\n\\n## String Methods\\n\\nStrings in PowerShell are .NET objects, so they have built-in methods:\\n\\n```powershell\\n\\\"hello world\\\".ToUpper()              # HELLO WORLD\\n\\\"hello world\\\".Replace(\\\"world\\\", \\\"PS\\\") # hello PS\\n\\\"one,two,three\\\".Split(\\\",\\\")           # array: one two three\\n\\\"  spaces  \\\".Trim()                  # spaces\\n```\\n\\n## Arrays\\n\\nCreate arrays with `@()` or comma-separated values. Access elements by zero-based index:\\n\\n```powershell\\n$colors = @(\\\"red\\\", \\\"green\\\", \\\"blue\\\")\\n$colors[0]     # red\\n$colors[-1]    # blue (last element)\\n$colors += \\\"yellow\\\"   # adds to the array\\n$colors.Count  # 4\\n```\\n\\nUse the range operator to create number sequences:\\n\\n```powershell\\n$nums = 1..5   # array: 1, 2, 3, 4, 5\\n```\\n\\n\\u003e **Key Concept:** The `+=` operator creates a **new array** behind the scenes. For small arrays this is fine, but for large-scale operations, use a `[System.Collections.Generic.List[object]]` instead.\\n\\n## Hashtables\\n\\nA hashtable stores **key-value pairs** using `@{}`:\\n\\n```powershell\\n$person = @{\\n    Name = \\\"Alice\\\"\\n    Age  = 30\\n    City = \\\"Seattle\\\"\\n}\\n$person[\\\"Name\\\"]   # Alice\\n$person.Age       # 30\\n$person[\\\"Role\\\"] = \\\"Admin\\\"   # add a new key\\n```\\n\\n## Ordered Hashtables\\n\\nRegular hashtables do not guarantee key order. Use `[ordered]` when order matters:\\n\\n```powershell\\n$config = [ordered]@{\\n    Host = \\\"localhost\\\"\\n    Port = 8080\\n    SSL  = $true\\n}\\n```\\n\\nThis preserves the order you defined the keys in, which is important for display and CSV export.\\n\"])</script><script>self.__next_f.push([1,\"4:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"min-h-screen bg-zinc-950 text-zinc-100\\\",\\\"children\\\":[[\\\"$\\\",\\\"header\\\",null,{\\\"className\\\":\\\"sticky top-0 z-10 border-b border-zinc-800/60 bg-zinc-950/80 backdrop-blur-xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto flex max-w-4xl items-center justify-between px-6 py-3.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/fundamentals\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 text-sm text-zinc-500 transition-colors hover:text-zinc-300\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"strokeWidth\\\":2,\\\"stroke\\\":\\\"currentColor\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18\\\"}]}],\\\"PowerShell Fundamentals\\\"]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/fundamentals/variables-and-types\\\",\\\"className\\\":\\\"flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-800 text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-200\\\",\\\"title\\\":\\\"Variables and Data Types\\\",\\\"children\\\":[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"strokeWidth\\\":2,\\\"stroke\\\":\\\"currentColor\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M15.75 19.5L8.25 12l7.5-7.5\\\"}]}]}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-xs tabular-nums text-zinc-500\\\",\\\"children\\\":[3,\\\" / \\\",9]}],[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/fundamentals/operators-and-comparisons\\\",\\\"className\\\":\\\"flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-800 text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-200\\\",\\\"title\\\":\\\"Operators and Comparisons\\\",\\\"children\\\":[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"strokeWidth\\\":2,\\\"stroke\\\":\\\"currentColor\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M8.25 4.5l7.5 7.5-7.5 7.5\\\"}]}]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-4xl px-6 pb-4\\\",\\\"children\\\":[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"text-2xl font-bold tracking-tight\\\",\\\"children\\\":\\\"Strings, Arrays, and Hashtables\\\"}]}]]}],[\\\"$\\\",\\\"$L10\\\",null,{\\\"lesson\\\":{\\\"meta\\\":{\\\"title\\\":\\\"Strings, Arrays, and Hashtables\\\",\\\"description\\\":\\\"Working with strings, arrays, and hashtable collections.\\\",\\\"slug\\\":\\\"strings-arrays-hashtables\\\",\\\"order\\\":3,\\\"prerequisites\\\":[\\\"m1-l2\\\"]},\\\"content\\\":\\\"$11\\\",\\\"exercises\\\":[{\\\"id\\\":\\\"m1-l3-ex1\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Given $city = \\\\\\\"Seattle\\\\\\\", write a double-quoted string that produces: \\\\\\\"I live in Seattle.\\\\\\\" using variable expansion (not concatenation).\\\",\\\"hints\\\":[\\\"Double quotes allow variable expansion with $variableName.\\\",\\\"Simply place $city inside the double-quoted string.\\\",\\\"Try: \\\\\\\"I live in $city.\\\\\\\"\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"\\\\\\\".*\\\\\\\\$city.*\\\\\\\"\\\",\\\"hintOnFail\\\":\\\"Use double quotes and include $city inside the string for variable expansion.\\\"},{\\\"rule\\\":\\\"forbidden\\\",\\\"value\\\":\\\"+\\\",\\\"hintOnFail\\\":\\\"Use variable expansion inside double quotes, not string concatenation with +.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"I live in\\\",\\\"hintOnFail\\\":\\\"The string should read: I live in $city.\\\"}],\\\"solution\\\":\\\"\\\\\\\"I live in $city.\\\\\\\"\\\",\\\"explanation\\\":\\\"Double-quoted strings expand variables automatically. PowerShell replaces $city with its value, producing \\\\\\\"I live in Seattle.\\\\\\\"\\\"},{\\\"id\\\":\\\"m1-l3-ex2\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Use the .Replace() string method to replace \\\\\\\"World\\\\\\\" with \\\\\\\"PowerShell\\\\\\\" in the string \\\\\\\"Hello, World!\\\\\\\" and store the result in $msg.\\\",\\\"hints\\\":[\\\"Call .Replace() on the string with two arguments.\\\",\\\"The first argument is the text to find, the second is the replacement.\\\",\\\"Try: $msg = \\\\\\\"Hello, World!\\\\\\\".Replace(\\\\\\\"World\\\\\\\", \\\\\\\"PowerShell\\\\\\\")\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"\\\\\\\\$msg\\\\\\\\s*=\\\",\\\"hintOnFail\\\":\\\"Store the result in a variable named $msg.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\".Replace(\\\",\\\"hintOnFail\\\":\\\"Use the .Replace() method on the string.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"\\\\\\\\.Replace\\\\\\\\(.*[\\\\\\\"']World[\\\\\\\"'].*,.*[\\\\\\\"']PowerShell[\\\\\\\"'].*\\\\\\\\)\\\",\\\"hintOnFail\\\":\\\"Pass \\\\\\\"World\\\\\\\" as the first argument and \\\\\\\"PowerShell\\\\\\\" as the second.\\\"}],\\\"solution\\\":\\\"$$msg = \\\\\\\"Hello, World!\\\\\\\".Replace(\\\\\\\"World\\\\\\\", \\\\\\\"PowerShell\\\\\\\")\\\",\\\"explanation\\\":\\\"The .Replace() method is a .NET string method that returns a new string with all occurrences of the first argument replaced by the second.\\\"},{\\\"id\\\":\\\"m1-l3-ex3\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Create an array called $fruits containing \\\\\\\"apple\\\\\\\", \\\\\\\"banana\\\\\\\", and \\\\\\\"cherry\\\\\\\" using the @() syntax.\\\",\\\"hints\\\":[\\\"Use @() with comma-separated values.\\\",\\\"Each value should be a quoted string.\\\",\\\"Try: $fruits = @(\\\\\\\"apple\\\\\\\", \\\\\\\"banana\\\\\\\", \\\\\\\"cherry\\\\\\\")\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"\\\\\\\\$fruits\\\\\\\\s*=\\\\\\\\s*@\\\\\\\\(\\\",\\\"hintOnFail\\\":\\\"Use $fruits = @(...) to create the array.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"apple\\\",\\\"hintOnFail\\\":\\\"Include \\\\\\\"apple\\\\\\\" in the array.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"banana\\\",\\\"hintOnFail\\\":\\\"Include \\\\\\\"banana\\\\\\\" in the array.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"cherry\\\",\\\"hintOnFail\\\":\\\"Include \\\\\\\"cherry\\\\\\\" in the array.\\\"}],\\\"solution\\\":\\\"$$fruits = @(\\\\\\\"apple\\\\\\\", \\\\\\\"banana\\\\\\\", \\\\\\\"cherry\\\\\\\")\\\",\\\"explanation\\\":\\\"The @() syntax explicitly creates an array. Comma-separated values inside the parentheses become the array elements.\\\"},{\\\"id\\\":\\\"m1-l3-ex4\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Create a hashtable called $server with keys: Name set to \\\\\\\"WebSrv01\\\\\\\", Port set to 443, and SSL set to $true.\\\",\\\"hints\\\":[\\\"Use @{} to create a hashtable.\\\",\\\"Separate key-value pairs with semicolons on one line, or use multiple lines.\\\",\\\"Keys use the format: Key = Value\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"\\\\\\\\$server\\\\\\\\s*=\\\\\\\\s*@\\\\\\\\{\\\",\\\"hintOnFail\\\":\\\"Use $server = @{...} to create the hashtable.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"Name\\\\\\\\s*=\\\\\\\\s*[\\\\\\\"']WebSrv01[\\\\\\\"']\\\",\\\"hintOnFail\\\":\\\"Set the Name key to \\\\\\\"WebSrv01\\\\\\\".\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"Port\\\\\\\\s*=\\\\\\\\s*443\\\",\\\"hintOnFail\\\":\\\"Set the Port key to 443.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"SSL\\\\\\\\s*=\\\\\\\\s*\\\\\\\\$true\\\",\\\"hintOnFail\\\":\\\"Set the SSL key to $true.\\\"}],\\\"solution\\\":\\\"$$server = @{ Name = \\\\\\\"WebSrv01\\\\\\\"; Port = 443; SSL = $true }\\\",\\\"explanation\\\":\\\"Hashtables store key-value pairs using @{} syntax. Keys and values are separated by =, and pairs are separated by semicolons or newlines.\\\"},{\\\"id\\\":\\\"m1-l3-ex5\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Create an ordered hashtable called $config with keys Host = \\\\\\\"localhost\\\\\\\" and Port = 8080. Use the [ordered] keyword.\\\",\\\"hints\\\":[\\\"Place [ordered] before @{} to create an ordered hashtable.\\\",\\\"This preserves the order in which you define the keys.\\\",\\\"Try: $config = [ordered]@{ Host = \\\\\\\"localhost\\\\\\\"; Port = 8080 }\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"\\\\\\\\$config\\\\\\\\s*=\\\\\\\\s*\\\\\\\\[ordered\\\\\\\\]\\\\\\\\s*@\\\\\\\\{\\\",\\\"hintOnFail\\\":\\\"Use [ordered]@{} to create an ordered hashtable.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"Host\\\\\\\\s*=\\\\\\\\s*[\\\\\\\"']localhost[\\\\\\\"']\\\",\\\"hintOnFail\\\":\\\"Set the Host key to \\\\\\\"localhost\\\\\\\".\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"Port\\\\\\\\s*=\\\\\\\\s*8080\\\",\\\"hintOnFail\\\":\\\"Set the Port key to 8080.\\\"},{\\\"rule\\\":\\\"order\\\",\\\"sequence\\\":[\\\"Host\\\",\\\"Port\\\"],\\\"hintOnFail\\\":\\\"Define Host before Port to maintain the correct order.\\\"}],\\\"solution\\\":\\\"$$config = [ordered]@{ Host = \\\\\\\"localhost\\\\\\\"; Port = 8080 }\\\",\\\"explanation\\\":\\\"The [ordered] keyword creates an OrderedDictionary that preserves insertion order, unlike a regular hashtable where key order is not guaranteed.\\\"}],\\\"moduleSlug\\\":\\\"fundamentals\\\"}}],\\\"$L12\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"12:[\\\"$\\\",\\\"footer\\\",null,{\\\"cl