",\\\"nonce\\\":\\\"$undefined\\\"}]]],\\\"S\\\":true,\\\"h\\\":null,\\\"s\\\":\\\"$undefined\\\",\\\"l\\\":\\\"$undefined\\\",\\\"p\\\":\\\"$undefined\\\",\\\"d\\\":\\\"$undefined\\\",\\\"b\\\":\\\"CCxR80sZRnjlIdOoXSFK7\\\"}\\n\"])</script><script>self.__next_f.push([1,\"e:[]\\n8:\\\"$We\\\"\\n\"])</script><script>self.__next_f.push([1,\"f:I[22016,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\",\\\"/_next/static/chunks/0xv9uz7g8af6d.js\\\"],\\\"\\\"]\\n10:I[16505,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\",\\\"/_next/static/chunks/0xv9uz7g8af6d.js\\\"],\\\"LessonClient\\\"]\\n11:T912,\"])</script><script>self.__next_f.push([1,\"# Working with Files\\n\\nPowerShell provides a rich set of cmdlets for reading, writing, and managing files. These cmdlets work with text, CSV, and JSON data out of the box.\\n\\n## Reading and Writing Text Files\\n\\nUse `Get-Content` to read a file (returns an array of lines) and `Set-Content` to write content (overwrites the file):\\n\\n```powershell\\n$lines = Get-Content -Path \\\".\\\\config.txt\\\"\\nSet-Content -Path \\\".\\\\output.txt\\\" -Value \\\"Hello, World!\\\"\\n```\\n\\nTo **append** to an existing file instead of overwriting, use `Add-Content`:\\n\\n```powershell\\nAdd-Content -Path \\\".\\\\log.txt\\\" -Value \\\"New log entry\\\"\\n```\\n\\n`Out-File` is similar to `Set-Content` but preserves PowerShell's formatting. It is what the `\\u003e` redirect operator uses internally:\\n\\n```powershell\\nGet-Process | Out-File -Path \\\".\\\\processes.txt\\\"\\n```\\n\\n\\u003e **Key Concept:** `Set-Content` writes raw strings. `Out-File` writes the formatted display output of objects. For data you plan to process later, prefer `Set-Content` or `Export-Csv`.\\n\\n## Checking If a Path Exists\\n\\nAlways verify a path before reading or writing:\\n\\n```powershell\\nif (Test-Path \\\".\\\\data.csv\\\") {\\n    $data = Get-Content \\\".\\\\data.csv\\\"\\n}\\n```\\n\\n## Working with CSV Files\\n\\n`Import-Csv` reads a CSV file and returns objects with properties matching the column headers. `Export-Csv` does the reverse:\\n\\n```powershell\\n$users = Import-Csv -Path \\\".\\\\users.csv\\\"\\n$users | Where-Object { $_.Department -eq \\\"IT\\\" } | Export-Csv -Path \\\".\\\\it-users.csv\\\" -NoTypeInformation\\n```\\n\\n## Working with JSON\\n\\nConvert objects to JSON with `ConvertTo-Json` and parse JSON strings with `ConvertFrom-Json`:\\n\\n```powershell\\n$config = @{ Server = \\\"prod-01\\\"; Port = 443 }\\n$config | ConvertTo-Json | Set-Content \\\".\\\\config.json\\\"\\n\\n$loaded = Get-Content \\\".\\\\config.json\\\" -Raw | ConvertFrom-Json\\n$loaded.Server   # prod-01\\n```\\n\\n\\u003e **Key Concept:** Use `-Raw` with `Get-Content` when reading JSON files. Without it, `Get-Content` returns an array of lines, which `ConvertFrom-Json` may not parse correctly.\\n\\n## Building File Paths Safely\\n\\nUse `Join-Path` and `Split-Path` instead of string concatenation to build cross-platform paths:\\n\\n```powershell\\n$fullPath = Join-Path -Path $HOME -ChildPath \\\"Documents\\\\report.csv\\\"\\n$folder   = Split-Path -Path $fullPath -Parent     # parent directory\\n$fileName = Split-Path -Path $fullPath -Leaf        # file name only\\n```\\n\"])</script><script>self.__next_f.push([1,\"4:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"min-h-screen bg-zinc-950 text-zinc-100\\\",\\\"children\\\":[[\\\"$\\\",\\\"header\\\",null,{\\\"className\\\":\\\"sticky top-0 z-10 border-b border-zinc-800/60 bg-zinc-950/80 backdrop-blur-xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto flex max-w-4xl items-center justify-between px-6 py-3.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/fundamentals\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 text-sm text-zinc-500 transition-colors hover:text-zinc-300\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"strokeWidth\\\":2,\\\"stroke\\\":\\\"currentColor\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18\\\"}]}],\\\"PowerShell Fundamentals\\\"]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/fundamentals/error-handling\\\",\\\"className\\\":\\\"flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-800 text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-200\\\",\\\"title\\\":\\\"Error Handling\\\",\\\"children\\\":[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"strokeWidth\\\":2,\\\"stroke\\\":\\\"currentColor\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M15.75 19.5L8.25 12l7.5-7.5\\\"}]}]}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-xs tabular-nums text-zinc-500\\\",\\\"children\\\":[8,\\\" / \\\",9]}],[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/fundamentals/modules\\\",\\\"className\\\":\\\"flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-800 text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-200\\\",\\\"title\\\":\\\"Modules\\\",\\\"children\\\":[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"strokeWidth\\\":2,\\\"stroke\\\":\\\"currentColor\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M8.25 4.5l7.5 7.5-7.5 7.5\\\"}]}]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-4xl px-6 pb-4\\\",\\\"children\\\":[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"text-2xl font-bold tracking-tight\\\",\\\"children\\\":\\\"Working with Files\\\"}]}]]}],[\\\"$\\\",\\\"$L10\\\",null,{\\\"lesson\\\":{\\\"meta\\\":{\\\"title\\\":\\\"Working with Files\\\",\\\"description\\\":\\\"Reading and writing CSV, JSON, and text files.\\\",\\\"slug\\\":\\\"working-with-files\\\",\\\"order\\\":8,\\\"prerequisites\\\":[\\\"m1-l7\\\"]},\\\"content\\\":\\\"$11\\\",\\\"exercises\\\":[{\\\"id\\\":\\\"m1-l8-ex1\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Write a command to read the contents of the file 'data.txt' and store the result in a variable called $content.\\\",\\\"hints\\\":[\\\"Use the Get-Content cmdlet.\\\",\\\"Specify the file path with the -Path parameter.\\\",\\\"Assign the result to $content with the = operator.\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Get-Content\\\",\\\"hintOnFail\\\":\\\"Use Get-Content to read the file.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"data\\\\\\\\.txt\\\",\\\"hintOnFail\\\":\\\"Specify 'data.txt' as the file path.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"\\\\\\\\$content\\\\\\\\s*=\\\",\\\"hintOnFail\\\":\\\"Assign the result to a variable called $content.\\\"}],\\\"solution\\\":\\\"$$content = Get-Content -Path 'data.txt'\\\",\\\"explanation\\\":\\\"Get-Content reads a file and returns an array of strings (one per line). Storing it in $content lets you work with the data later.\\\"},{\\\"id\\\":\\\"m1-l8-ex2\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Write a command to append the text 'Task completed' to a file called 'log.txt' using Add-Content.\\\",\\\"hints\\\":[\\\"Add-Content appends to a file instead of overwriting.\\\",\\\"Use -Path for the file and -Value for the text.\\\",\\\"Don't use Set-Content — that overwrites the file.\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Add-Content\\\",\\\"hintOnFail\\\":\\\"Use Add-Content to append to the file.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"log\\\\\\\\.txt\\\",\\\"hintOnFail\\\":\\\"Specify 'log.txt' as the file path.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"Task completed\\\",\\\"hintOnFail\\\":\\\"Set the value to 'Task completed'.\\\"},{\\\"rule\\\":\\\"forbidden\\\",\\\"value\\\":\\\"Set-Content\\\",\\\"hintOnFail\\\":\\\"Use Add-Content (not Set-Content) to append without overwriting.\\\"}],\\\"solution\\\":\\\"Add-Content -Path 'log.txt' -Value 'Task completed'\\\",\\\"explanation\\\":\\\"Add-Content appends the specified value to the end of the file, preserving existing content. Set-Content would overwrite the file entirely.\\\"},{\\\"id\\\":\\\"m1-l8-ex3\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Write a command that imports 'employees.csv' and pipes the result to Where-Object to filter rows where the Department property equals 'Sales', then exports the result to 'sales-team.csv' with -NoTypeInformation.\\\",\\\"hints\\\":[\\\"Start with Import-Csv, then pipe to Where-Object, then pipe to Export-Csv.\\\",\\\"Use $_.Department -eq 'Sales' in the Where-Object filter.\\\",\\\"Add -NoTypeInformation to Export-Csv to omit the type header.\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Import-Csv\\\",\\\"hintOnFail\\\":\\\"Start by reading the CSV with Import-Csv.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Where-Object\\\",\\\"hintOnFail\\\":\\\"Pipe to Where-Object to filter the data.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Export-Csv\\\",\\\"hintOnFail\\\":\\\"Pipe the filtered results to Export-Csv.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"employees\\\\\\\\.csv\\\",\\\"hintOnFail\\\":\\\"Import from 'employees.csv'.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"sales-team\\\\\\\\.csv\\\",\\\"hintOnFail\\\":\\\"Export to 'sales-team.csv'.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"-NoTypeInformation\\\",\\\"hintOnFail\\\":\\\"Add the -NoTypeInformation switch to Export-Csv.\\\"},{\\\"rule\\\":\\\"structure\\\",\\\"check\\\":\\\"has-pipeline\\\",\\\"hintOnFail\\\":\\\"Use the pipeline | to connect the cmdlets.\\\"}],\\\"solution\\\":\\\"Import-Csv -Path 'employees.csv' | Where-Object { $_.Department -eq 'Sales' } | Export-Csv -Path 'sales-team.csv' -NoTypeInformation\\\",\\\"explanation\\\":\\\"Import-Csv converts each CSV row into an object. Where-Object filters those objects. Export-Csv writes the filtered objects back to a new CSV file. -NoTypeInformation removes the #TYPE header line.\\\"},{\\\"id\\\":\\\"m1-l8-ex4\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Write code that reads 'config.json' as a single string using Get-Content with -Raw, then converts it from JSON into an object stored in $config.\\\",\\\"hints\\\":[\\\"Use Get-Content with the -Raw switch to read the file as one string.\\\",\\\"Pipe the result to ConvertFrom-Json.\\\",\\\"Store the final result in $config.\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Get-Content\\\",\\\"hintOnFail\\\":\\\"Use Get-Content to read the file.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"-Raw\\\",\\\"hintOnFail\\\":\\\"Add the -Raw switch to read the entire file as a single string.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"ConvertFrom-Json\\\",\\\"hintOnFail\\\":\\\"Pipe to ConvertFrom-Json to parse the JSON.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"config\\\\\\\\.json\\\",\\\"hintOnFail\\\":\\\"Read from the file 'config.json'.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"\\\\\\\\$config\\\\\\\\s*=\\\",\\\"hintOnFail\\\":\\\"Store the result in a variable called $config.\\\"}],\\\"solution\\\":\\\"$$config = Get-Content -Path 'config.json' -Raw | ConvertFrom-Json\\\",\\\"explanation\\\":\\\"-Raw ensures Get-Content returns the entire file as a single string rather than an array of lines. ConvertFrom-Json then parses that string into a PowerShell object.\\\"},{\\\"id\\\":\\\"m1-l8-ex5\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Use Join-Path to combine $HOME and 'Documents\\\\\\\\report.txt' into a full file path, and store it in $fullPath.\\\",\\\"hints\\\":[\\\"Join-Path takes -Path and -ChildPath parameters.\\\",\\\"$$HOME is a built-in variable for the user's home directory.\\\",\\\"Assign the result to $fullPath.\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Join-Path\\\",\\\"hintOnFail\\\":\\\"Use the Join-Path cmdlet.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"\\\\\\\\$HOME\\\",\\\"hintOnFail\\\":\\\"Use $HOME as the base path.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"Documents\\\",\\\"hintOnFail\\\":\\\"Include 'Documents' in the child path.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"report\\\\\\\\.txt\\\",\\\"hintOnFail\\\":\\\"Include 'report.txt' in the child path.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"\\\\\\\\$fullPath\\\\\\\\s*=\\\",\\\"hintOnFail\\\":\\\"Store the result in $fullPath.\\\"}],\\\"solution\\\":\\\"$$fullPath = Join-Path -Path $HOME -ChildPath 'Documents\\\\\\\\report.txt'\\\",\\\"explanation\\\":\\\"Join-Path safely combines path segments using the correct directory separator for the platform, avoiding issues with missing or doubled backslashes.\\\"}],\\\"moduleSlug\\\":\\\"fundamentals\\\"}}],\\\"$L12\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"12:[\\\"$\\\",\\\"footer\\\",null,{\\\"className\\\":\\\"border-t border-zinc-800/60\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto flex max-w-4xl items-center justify-between px-6 py-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/fundamentals/error-handling\\\",\\\"className\\\":\\\"group flex items-center gap-2 text-sm text-zinc-400 transition-colors hover:text-zinc-200\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4 tra