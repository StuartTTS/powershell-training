ateStyles\\\":\\\"$undefined\\\",\\\"templateScripts\\\":\\\"$undefined\\\",\\\"notFound\\\":\\\"$undefined\\\",\\\"forbidden\\\":\\\"$undefined\\\",\\\"unauthorized\\\":\\\"$undefined\\\"}]]}],{\\\"children\\\":[[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[\\\"$L4\\\",[[\\\"$\\\",\\\"script\\\",\\\"script-0\\\",{\\\"src\\\":\\\"/_next/static/chunks/0xv9uz7g8af6d.js\\\",\\\"async\\\":true,\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"$L5\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$6\\\",null,{\\\"name\\\":\\\"Next.MetadataOutlet\\\",\\\"children\\\":\\\"$@7\\\"}]}]]}],{},null,false,null]},null,false,\\\"$@8\\\"]},null,false,\\\"$@8\\\"]},null,false,\\\"$@8\\\"]},null,false,null],[\\\"$\\\",\\\"$1\\\",\\\"h\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L9\\\",null,{\\\"children\\\":\\\"$La\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$Lb\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$6\\\",null,{\\\"name\\\":\\\"Next.Metadata\\\",\\\"children\\\":\\\"$Lc\\\"}]}]}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]]}],false]],\\\"m\\\":\\\"$undefined\\\",\\\"G\\\":[\\\"$d\\\",[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/0-7zhabl4g7ue.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]]],\\\"S\\\":true,\\\"h\\\":null,\\\"s\\\":\\\"$undefined\\\",\\\"l\\\":\\\"$undefined\\\",\\\"p\\\":\\\"$undefined\\\",\\\"d\\\":\\\"$undefined\\\",\\\"b\\\":\\\"CCxR80sZRnjlIdOoXSFK7\\\"}\\n\"])</script><script>self.__next_f.push([1,\"e:[]\\n8:\\\"$We\\\"\\n\"])</script><script>self.__next_f.push([1,\"f:I[22016,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\",\\\"/_next/static/chunks/0xv9uz7g8af6d.js\\\"],\\\"\\\"]\\n10:I[16505,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\",\\\"/_next/static/chunks/0xv9uz7g8af6d.js\\\"],\\\"LessonClient\\\"]\\n11:T871,\"])</script><script>self.__next_f.push([1,\"# Variables and Data Types\\n\\nIn PowerShell, variables are storage containers for data. Every variable name starts with a `$` sign, and you create one simply by assigning a value to it.\\n\\n## Creating and Assigning Variables\\n\\n```powershell\\n$name = \\\"Alice\\\"\\n$age = 30\\n$isAdmin = $true\\n```\\n\\nNo declaration keyword is needed — variables spring into existence on first assignment. Variable names are **case-insensitive**, so `$Name` and `$name` refer to the same variable.\\n\\n\\u003e **Key Concept:** PowerShell uses **automatic type detection**. When you assign `42`, the variable becomes an `[int]`. Assign `\\\"hello\\\"`, and it becomes a `[string]`. You can check a variable's type with `.GetType()`.\\n\\n```powershell\\n$count = 42\\n$count.GetType().Name   # Int32\\n\\n$count = \\\"hello\\\"\\n$count.GetType().Name   # String\\n```\\n\\n## Common Data Types\\n\\n| Type         | Example                          |\\n|--------------|----------------------------------|\\n| `[string]`   | `\\\"Hello World\\\"`                  |\\n| `[int]`      | `42`                             |\\n| `[bool]`     | `$true`, `$false`                |\\n| `[array]`    | `@(1, 2, 3)`                    |\\n| `[datetime]` | `Get-Date`                       |\\n\\n## Type Casting\\n\\nYou can force a variable to a specific type by placing the type accelerator before the variable name or the value:\\n\\n```powershell\\n[int]$port = \\\"8080\\\"          # converts string \\\"8080\\\" to integer 8080\\n[string]$code = 404          # converts integer 404 to string \\\"404\\\"\\n[datetime]$date = \\\"2025-01-15\\\"  # converts string to DateTime object\\n```\\n\\nOnce a variable is constrained with a type, it rejects incompatible values:\\n\\n```powershell\\n[int]$number = 10\\n$number = \\\"hello\\\"   # Error — \\\"hello\\\" cannot convert to int\\n```\\n\\n## The $null Value\\n\\n`$null` represents the absence of a value. Any variable that has never been assigned is `$null`:\\n\\n```powershell\\n$undefined -eq $null   # True\\n```\\n\\n\\u003e **Key Concept:** Always place `$null` on the left side of comparisons (`$null -eq $var`) to avoid unexpected behavior when `$var` is an array.\\n\\nUse `$null` to explicitly clear a variable:\\n\\n```powershell\\n$data = \\\"something\\\"\\n$data = $null   # variable now has no value\\n```\\n\"])</script><script>self.__next_f.push([1,\"4:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"min-h-screen bg-zinc-950 text-zinc-100\\\",\\\"children\\\":[[\\\"$\\\",\\\"header\\\",null,{\\\"className\\\":\\\"sticky top-0 z-10 border-b border-zinc-800/60 bg-zinc-950/80 backdrop-blur-xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto flex max-w-4xl items-center justify-between px-6 py-3.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/fundamentals\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 text-sm text-zinc-500 transition-colors hover:text-zinc-300\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"strokeWidth\\\":2,\\\"stroke\\\":\\\"currentColor\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18\\\"}]}],\\\"PowerShell Fundamentals\\\"]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/fundamentals/what-is-powershell\\\",\\\"className\\\":\\\"flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-800 text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-200\\\",\\\"title\\\":\\\"What is PowerShell?\\\",\\\"children\\\":[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"strokeWidth\\\":2,\\\"stroke\\\":\\\"currentColor\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M15.75 19.5L8.25 12l7.5-7.5\\\"}]}]}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-xs tabular-nums text-zinc-500\\\",\\\"children\\\":[2,\\\" / \\\",9]}],[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/fundamentals/strings-arrays-hashtables\\\",\\\"className\\\":\\\"flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-800 text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-200\\\",\\\"title\\\":\\\"Strings, Arrays, and Hashtables\\\",\\\"children\\\":[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"strokeWidth\\\":2,\\\"stroke\\\":\\\"currentColor\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M8.25 4.5l7.5 7.5-7.5 7.5\\\"}]}]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-4xl px-6 pb-4\\\",\\\"children\\\":[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"text-2xl font-bold tracking-tight\\\",\\\"children\\\":\\\"Variables and Data Types\\\"}]}]]}],[\\\"$\\\",\\\"$L10\\\",null,{\\\"lesson\\\":{\\\"meta\\\":{\\\"title\\\":\\\"Variables and Data Types\\\",\\\"description\\\":\\\"Introduction to PowerShell variables, types, and type casting.\\\",\\\"slug\\\":\\\"variables-and-types\\\",\\\"order\\\":2,\\\"prerequisites\\\":[\\\"m1-l1\\\"]},\\\"content\\\":\\\"$11\\\",\\\"exercises\\\":[{\\\"id\\\":\\\"m1-l2-ex1\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Create a variable called $greeting and assign it the value \\\\\\\"Hello, World!\\\\\\\".\\\",\\\"hints\\\":[\\\"Variable names in PowerShell start with $.\\\",\\\"Use the = operator to assign a value.\\\",\\\"Strings are wrapped in quotes.\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"\\\\\\\\$greeting\\\\\\\\s*=\\\",\\\"hintOnFail\\\":\\\"Name the variable $greeting and use = to assign a value.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"[\\\\\\\"']Hello,\\\\\\\\s*World![\\\\\\\"']\\\",\\\"hintOnFail\\\":\\\"Assign the string \\\\\\\"Hello, World!\\\\\\\" as the value.\\\"}],\\\"solution\\\":\\\"$$greeting = \\\\\\\"Hello, World!\\\\\\\"\\\",\\\"explanation\\\":\\\"Variables are created by assigning a value with the $ prefix and = operator. No declaration keyword is needed.\\\"},{\\\"id\\\":\\\"m1-l2-ex2\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Create a variable $port constrained to the [int] type and assign it the value 443.\\\",\\\"hints\\\":[\\\"Place the type accelerator before the variable name.\\\",\\\"Type accelerators use square brackets, like [int].\\\",\\\"Try: [int]$port = 443\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"\\\\\\\\[int\\\\\\\\]\\\\\\\\s*\\\\\\\\$port\\\",\\\"hintOnFail\\\":\\\"Use [int] before $port to constrain its type.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"443\\\",\\\"hintOnFail\\\":\\\"Assign the value 443.\\\"}],\\\"solution\\\":\\\"[int]$port = 443\\\",\\\"explanation\\\":\\\"Placing [int] before the variable name constrains it to only accept integer values. Assigning a non-convertible value later will cause an error.\\\"},{\\\"id\\\":\\\"m1-l2-ex3\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Cast the string \\\\\\\"2025-06-15\\\\\\\" to a [datetime] and store it in a variable called $releaseDate.\\\",\\\"hints\\\":[\\\"Use [datetime] as the type accelerator.\\\",\\\"Place it before the variable name or before the value.\\\",\\\"Try: [datetime]$releaseDate = \\\\\\\"2025-06-15\\\\\\\"\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"\\\\\\\\[datetime\\\\\\\\]\\\",\\\"hintOnFail\\\":\\\"Use [datetime] to cast the string to a DateTime object.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"\\\\\\\\$releaseDate\\\\\\\\s*=\\\",\\\"hintOnFail\\\":\\\"Store the result in a variable named $releaseDate.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"2025-06-15\\\",\\\"hintOnFail\\\":\\\"Use the date string \\\\\\\"2025-06-15\\\\\\\".\\\"}],\\\"solution\\\":\\\"[datetime]$releaseDate = \\\\\\\"2025-06-15\\\\\\\"\\\",\\\"explanation\\\":\\\"PowerShell can parse common date string formats and convert them to [datetime] objects automatically when you specify the type.\\\"},{\\\"id\\\":\\\"m1-l2-ex4\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Write an expression that checks whether the variable $result is $null. Place $null on the left side of the comparison, as recommended.\\\",\\\"hints\\\":[\\\"Use the -eq comparison operator.\\\",\\\"Best practice is to put $null on the left: $null -eq $variable.\\\",\\\"This avoids unexpected behavior when the variable is an array.\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"\\\\\\\\$null\\\\\\\\s+-eq\\\\\\\\s+\\\\\\\\$result\\\",\\\"hintOnFail\\\":\\\"Place $null on the left side: $null -eq $result.\\\"},{\\\"rule\\\":\\\"forbidden\\\",\\\"value\\\":\\\"$$result -eq\\\",\\\"hintOnFail\\\":\\\"Put $null on the left side of the comparison, not $result.\\\"}],\\\"solution\\\":\\\"$$null -eq $result\\\",\\\"explanation\\\":\\\"Placing $null on the left side prevents unexpected behavior when $result is an array, because -eq against an array filters elements rather than performing a simple equality check.\\\"}],\\\"moduleSlug\\\":\\\"fundamentals\\\"}}],\\\"$L12\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"12:[\\\"$\\\",\\\"footer\\\",null,{\\\"className\\\":\\\"border-t border-zinc-800/60\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto flex max-w-4xl items-center justify-between px-6 py-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lf\\\",null,{\\\"hr