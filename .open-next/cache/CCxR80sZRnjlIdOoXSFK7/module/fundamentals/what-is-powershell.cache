\"src\\\":\\\"/_next/static/chunks/0xv9uz7g8af6d.js\\\",\\\"async\\\":true,\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"$L5\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$6\\\",null,{\\\"name\\\":\\\"Next.MetadataOutlet\\\",\\\"children\\\":\\\"$@7\\\"}]}]]}],{},null,false,null]},null,false,\\\"$@8\\\"]},null,false,\\\"$@8\\\"]},null,false,\\\"$@8\\\"]},null,false,null],[\\\"$\\\",\\\"$1\\\",\\\"h\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L9\\\",null,{\\\"children\\\":\\\"$La\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$Lb\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$6\\\",null,{\\\"name\\\":\\\"Next.Metadata\\\",\\\"children\\\":\\\"$Lc\\\"}]}]}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]]}],false]],\\\"m\\\":\\\"$undefined\\\",\\\"G\\\":[\\\"$d\\\",[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/0-7zhabl4g7ue.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]]],\\\"S\\\":true,\\\"h\\\":null,\\\"s\\\":\\\"$undefined\\\",\\\"l\\\":\\\"$undefined\\\",\\\"p\\\":\\\"$undefined\\\",\\\"d\\\":\\\"$undefined\\\",\\\"b\\\":\\\"CCxR80sZRnjlIdOoXSFK7\\\"}\\n\"])</script><script>self.__next_f.push([1,\"e:[]\\n8:\\\"$We\\\"\\n\"])</script><script>self.__next_f.push([1,\"f:I[22016,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\",\\\"/_next/static/chunks/0xv9uz7g8af6d.js\\\"],\\\"\\\"]\\n10:I[16505,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\",\\\"/_next/static/chunks/0xv9uz7g8af6d.js\\\"],\\\"LessonClient\\\"]\\n11:T5a0,\"])</script><script>self.__next_f.push([1,\"# What is PowerShell?\\n\\nPowerShell is a cross-platform task automation solution made up of a command-line shell, a scripting language, and a configuration management framework. Unlike traditional shells that work with text, PowerShell works with **objects** — structured data that you can filter, sort, and manipulate.\\n\\n## Cmdlets\\n\\nThe basic commands in PowerShell are called **cmdlets** (pronounced \\\"command-lets\\\"). They follow a consistent `Verb-Noun` naming pattern:\\n\\n```powershell\\nGet-Process\\nGet-Service\\nSet-Location\\n```\\n\\n\\u003e **Key Concept:** The Verb-Noun pattern makes cmdlets discoverable. If you need to get something, the cmdlet probably starts with `Get-`. Need to change something? Try `Set-`.\\n\\n## The Pipeline\\n\\nPowerShell's pipeline (`|`) passes **objects** (not just text) from one cmdlet to the next:\\n\\n```powershell\\nGet-Process | Where-Object { $_.CPU -gt 100 }\\n```\\n\\nThis gets all running processes, then filters to only those using more than 100 seconds of CPU time.\\n\\n## Get-Help\\n\\nWhen you're unsure about a cmdlet, `Get-Help` is your best friend:\\n\\n```powershell\\nGet-Help Get-Process\\nGet-Help Get-Process -Examples\\nGet-Help Get-Process -Full\\n```\\n\\n\\u003e **Key Concept:** Always try `Get-Help \\u003ccmdlet\\u003e -Examples` first — real examples are the fastest way to learn how a cmdlet works.\\n\\n## Get-Command\\n\\nUse `Get-Command` to discover cmdlets:\\n\\n```powershell\\nGet-Command -Verb Get\\nGet-Command -Noun Process\\nGet-Command *service*\\n```\\n\"])</script><script>self.__next_f.push([1,\"4:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"min-h-screen bg-zinc-950 text-zinc-100\\\",\\\"children\\\":[[\\\"$\\\",\\\"header\\\",null,{\\\"className\\\":\\\"sticky top-0 z-10 border-b border-zinc-800/60 bg-zinc-950/80 backdrop-blur-xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto flex max-w-4xl items-center justify-between px-6 py-3.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/fundamentals\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 text-sm text-zinc-500 transition-colors hover:text-zinc-300\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"strokeWidth\\\":2,\\\"stroke\\\":\\\"currentColor\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18\\\"}]}],\\\"PowerShell Fundamentals\\\"]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"h-8 w-8\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-xs tabular-nums text-zinc-500\\\",\\\"children\\\":[1,\\\" / \\\",9]}],[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/fundamentals/variables-and-types\\\",\\\"className\\\":\\\"flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-800 text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-200\\\",\\\"title\\\":\\\"Variables and Data Types\\\",\\\"children\\\":[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"strokeWidth\\\":2,\\\"stroke\\\":\\\"currentColor\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M8.25 4.5l7.5 7.5-7.5 7.5\\\"}]}]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-4xl px-6 pb-4\\\",\\\"children\\\":[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"text-2xl font-bold tracking-tight\\\",\\\"children\\\":\\\"What is PowerShell?\\\"}]}]]}],[\\\"$\\\",\\\"$L10\\\",null,{\\\"lesson\\\":{\\\"meta\\\":{\\\"title\\\":\\\"What is PowerShell?\\\",\\\"description\\\":\\\"Introduction to PowerShell — cmdlets, the pipeline, and Get-Help.\\\",\\\"slug\\\":\\\"what-is-powershell\\\",\\\"order\\\":1,\\\"prerequisites\\\":[]},\\\"content\\\":\\\"$11\\\",\\\"exercises\\\":[{\\\"id\\\":\\\"m1-l1-ex1\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Write the cmdlet that displays help information for the Get-Service cmdlet.\\\",\\\"hints\\\":[\\\"The help cmdlet follows the Verb-Noun pattern too.\\\",\\\"The verb is 'Get' and the noun is 'Help'.\\\",\\\"Try: Get-Help Get-Service\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Get-Help\\\",\\\"hintOnFail\\\":\\\"Use the Get-Help cmdlet.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Get-Service\\\",\\\"hintOnFail\\\":\\\"Pass Get-Service as the argument to Get-Help.\\\"}],\\\"solution\\\":\\\"Get-Help Get-Service\\\",\\\"explanation\\\":\\\"Get-Help followed by a cmdlet name shows you documentation for that cmdlet.\\\"},{\\\"id\\\":\\\"m1-l1-ex2\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Write a command that finds all cmdlets with the verb 'Set'.\\\",\\\"hints\\\":[\\\"Use Get-Command to discover cmdlets.\\\",\\\"Get-Command has a -Verb parameter.\\\",\\\"Try: Get-Command -Verb Set\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Get-Command\\\",\\\"hintOnFail\\\":\\\"Use the Get-Command cmdlet to discover commands.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"-Verb\\\\\\\\s+['\\\\\\\"]?Set['\\\\\\\"]?\\\",\\\"hintOnFail\\\":\\\"Use the -Verb parameter with 'Set'.\\\"}],\\\"solution\\\":\\\"Get-Command -Verb Set\\\",\\\"explanation\\\":\\\"Get-Command -Verb Set returns all cmdlets that use the Set verb, helping you discover what you can configure.\\\"},{\\\"id\\\":\\\"m1-l1-ex3\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Write a pipeline that gets all processes and pipes them to Where-Object to filter for processes where the name equals 'explorer'.\\\",\\\"hints\\\":[\\\"Start with Get-Process, then pipe with |\\\",\\\"Where-Object uses a script block { } with $_ to reference each object.\\\",\\\"Try: Get-Process | Where-Object { $_.Name -eq 'explorer' }\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Get-Process\\\",\\\"hintOnFail\\\":\\\"Start with the Get-Process cmdlet.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"|\\\",\\\"hintOnFail\\\":\\\"Use the pipeline operator | to pass objects.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Where-Object\\\",\\\"hintOnFail\\\":\\\"Pipe to Where-Object to filter results.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"\\\\\\\\$_\\\\\\\\.Name\\\\\\\\s+-eq\\\",\\\"hintOnFail\\\":\\\"Use $_.Name -eq to compare the process name.\\\"}],\\\"solution\\\":\\\"Get-Process | Where-Object { $_.Name -eq 'explorer' }\\\",\\\"explanation\\\":\\\"The pipeline passes process objects to Where-Object, which filters them using the script block condition.\\\"}],\\\"moduleSlug\\\":\\\"fundamentals\\\"}}],\\\"$L12\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"12:[\\\"$\\\",\\\"footer\\\",null,{\\\"className\\\":\\\"border-t border-zinc-800/60\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto flex max-w-4xl items-center justify-between px-6 py-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{}],[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/fundamentals/variables-and-types\\\",\\\"className\\\":\\\"group flex items-center gap-2 text-sm text-zinc-400 transition-colors hover:text-zinc-200\\\",\\\"children\\\":[\\\"Variables and Data Types\\\",[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4 transition-transform group-hover:translate-x-0.5\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"strokeWidth\\\":2,\\\"stroke\\\":\\\"currentColor\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3\\\"}]}]]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"a:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\n\"