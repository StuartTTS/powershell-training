undefined\\\"}]]],\\\"S\\\":true,\\\"h\\\":null,\\\"s\\\":\\\"$undefined\\\",\\\"l\\\":\\\"$undefined\\\",\\\"p\\\":\\\"$undefined\\\",\\\"d\\\":\\\"$undefined\\\",\\\"b\\\":\\\"CCxR80sZRnjlIdOoXSFK7\\\"}\\n\"])</script><script>self.__next_f.push([1,\"e:[]\\n8:\\\"$We\\\"\\n\"])</script><script>self.__next_f.push([1,\"f:I[22016,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\",\\\"/_next/static/chunks/0xv9uz7g8af6d.js\\\"],\\\"\\\"]\\n10:I[16505,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\",\\\"/_next/static/chunks/0xv9uz7g8af6d.js\\\"],\\\"LessonClient\\\"]\\n11:T9c5,\"])</script><script>self.__next_f.push([1,\"# Modules\\n\\nModules are packages of PowerShell commands -- cmdlets, functions, variables, and more -- bundled together for easy distribution and reuse. They are how the PowerShell ecosystem extends beyond the built-in commands.\\n\\n## Why Modules Matter\\n\\nInstead of writing everything from scratch, you can install modules that provide ready-made commands for Azure, Microsoft 365, databases, and thousands of other tasks. Modules keep your scripts concise and let you leverage community-tested code.\\n\\n## Discovering Loaded Modules\\n\\nUse `Get-Module` to see what is currently loaded in your session:\\n\\n```powershell\\nGet-Module\\n```\\n\\nTo see **all** modules installed on your system (not just loaded ones), add `-ListAvailable`:\\n\\n```powershell\\nGet-Module -ListAvailable\\n```\\n\\n\\u003e **Key Concept:** PowerShell auto-imports modules when you call one of their commands. You rarely need to call `Import-Module` manually, but it is useful when you want to load a specific version or confirm a module is available.\\n\\n## Finding Modules in the Gallery\\n\\nThe **PowerShell Gallery** (PSGallery) is the central public repository. Use `Find-Module` to search it:\\n\\n```powershell\\nFind-Module -Name \\\"*SharePoint*\\\"\\nFind-Module -Tag \\\"Azure\\\"\\n```\\n\\n## Installing Modules\\n\\nInstall a module from the gallery with `Install-Module`:\\n\\n```powershell\\nInstall-Module -Name Az -Scope CurrentUser\\n```\\n\\nThe `-Scope CurrentUser` flag installs the module in your personal modules folder, which does not require administrator privileges.\\n\\n\\u003e **Key Concept:** Always review a module before installing. Use `Find-Module -Name \\u003cname\\u003e` to check the author, download count, and description before running `Install-Module`.\\n\\n## Importing Modules\\n\\nAlthough PowerShell auto-imports modules on first use, you can explicitly load one:\\n\\n```powershell\\nImport-Module -Name Az.Accounts\\n```\\n\\nThis is useful in scripts where you want to guarantee the module is loaded before calling any of its commands.\\n\\n## Key Modules to Know\\n\\n| Module | Purpose |\\n|---|---|\\n| **Az** | Managing Azure resources |\\n| **Microsoft.Graph** | Microsoft 365 and Entra ID (Azure AD) |\\n| **PnP.PowerShell** | SharePoint Online administration |\\n| **PSReadLine** | Enhanced command-line editing (built-in) |\\n| **Pester** | Testing framework for PowerShell scripts |\\n| **ImportExcel** | Read/write Excel files without Excel installed |\\n\\n## Checking Module Versions\\n\\nAfter installing, verify the version with:\\n\\n```powershell\\nGet-Module -Name Az -ListAvailable | Select-Object Name, Version\\n```\\n\"])</script><script>self.__next_f.push([1,\"4:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"min-h-screen bg-zinc-950 text-zinc-100\\\",\\\"children\\\":[[\\\"$\\\",\\\"header\\\",null,{\\\"className\\\":\\\"sticky top-0 z-10 border-b border-zinc-800/60 bg-zinc-950/80 backdrop-blur-xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto flex max-w-4xl items-center justify-between px-6 py-3.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/fundamentals\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 text-sm text-zinc-500 transition-colors hover:text-zinc-300\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"strokeWidth\\\":2,\\\"stroke\\\":\\\"currentColor\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18\\\"}]}],\\\"PowerShell Fundamentals\\\"]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/module/fundamentals/working-with-files\\\",\\\"className\\\":\\\"flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-800 text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-200\\\",\\\"title\\\":\\\"Working with Files\\\",\\\"children\\\":[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"strokeWidth\\\":2,\\\"stroke\\\":\\\"currentColor\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M15.75 19.5L8.25 12l7.5-7.5\\\"}]}]}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-xs tabular-nums text-zinc-500\\\",\\\"children\\\":[9,\\\" / \\\",9]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"h-8 w-8\\\"}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-4xl px-6 pb-4\\\",\\\"children\\\":[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"text-2xl font-bold tracking-tight\\\",\\\"children\\\":\\\"Modules\\\"}]}]]}],[\\\"$\\\",\\\"$L10\\\",null,{\\\"lesson\\\":{\\\"meta\\\":{\\\"title\\\":\\\"Modules\\\",\\\"description\\\":\\\"Installing and importing PowerShell modules.\\\",\\\"slug\\\":\\\"modules\\\",\\\"order\\\":9,\\\"prerequisites\\\":[\\\"m1-l8\\\"]},\\\"content\\\":\\\"$11\\\",\\\"exercises\\\":[{\\\"id\\\":\\\"m1-l9-ex1\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Write a command to list all modules currently loaded in your PowerShell session.\\\",\\\"hints\\\":[\\\"Use the Get-Module cmdlet.\\\",\\\"Without any extra parameters, Get-Module shows loaded modules.\\\",\\\"You do not need -ListAvailable for currently loaded modules.\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Get-Module\\\",\\\"hintOnFail\\\":\\\"Use the Get-Module cmdlet.\\\"},{\\\"rule\\\":\\\"forbidden\\\",\\\"value\\\":\\\"-ListAvailable\\\",\\\"hintOnFail\\\":\\\"Do not use -ListAvailable — that shows all installed modules, not just loaded ones.\\\"}],\\\"solution\\\":\\\"Get-Module\\\",\\\"explanation\\\":\\\"Get-Module without parameters lists only the modules currently loaded in the session. Add -ListAvailable to see all installed modules.\\\"},{\\\"id\\\":\\\"m1-l9-ex2\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Write a command to search the PowerShell Gallery for modules with names containing 'SharePoint'.\\\",\\\"hints\\\":[\\\"Use Find-Module to search the online gallery.\\\",\\\"Use the -Name parameter with a wildcard pattern.\\\",\\\"Wildcards in PowerShell use the * character.\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Find-Module\\\",\\\"hintOnFail\\\":\\\"Use Find-Module to search the PowerShell Gallery.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"\\\\\\\\*?SharePoint\\\\\\\\*?\\\",\\\"hintOnFail\\\":\\\"Search for modules containing 'SharePoint' (use wildcards like *SharePoint*).\\\"}],\\\"solution\\\":\\\"Find-Module -Name '*SharePoint*'\\\",\\\"explanation\\\":\\\"Find-Module searches the PowerShell Gallery (PSGallery) for modules matching the pattern. Wildcards let you find modules even when you don't know the exact name.\\\"},{\\\"id\\\":\\\"m1-l9-ex3\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Write a command to install the 'PnP.PowerShell' module for the current user only (without requiring admin privileges).\\\",\\\"hints\\\":[\\\"Use Install-Module with the -Name parameter.\\\",\\\"Add -Scope CurrentUser to install without admin rights.\\\",\\\"The module name is PnP.PowerShell.\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Install-Module\\\",\\\"hintOnFail\\\":\\\"Use the Install-Module cmdlet.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"PnP\\\\\\\\.PowerShell\\\",\\\"hintOnFail\\\":\\\"Specify the module name as PnP.PowerShell.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"-Scope\\\\\\\\s+CurrentUser\\\",\\\"hintOnFail\\\":\\\"Add -Scope CurrentUser to install without administrator privileges.\\\"}],\\\"solution\\\":\\\"Install-Module -Name PnP.PowerShell -Scope CurrentUser\\\",\\\"explanation\\\":\\\"Install-Module downloads the module from the PowerShell Gallery and installs it. -Scope CurrentUser places it in your personal module directory, so no admin elevation is needed.\\\"},{\\\"id\\\":\\\"m1-l9-ex4\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Write a command to explicitly import the 'Microsoft.Graph' module into your current session.\\\",\\\"hints\\\":[\\\"Use Import-Module to load a module.\\\",\\\"Specify the module name with -Name.\\\",\\\"This forces the module to load even if it hasn't been auto-imported yet.\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Import-Module\\\",\\\"hintOnFail\\\":\\\"Use the Import-Module cmdlet.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"Microsoft\\\\\\\\.Graph\\\",\\\"hintOnFail\\\":\\\"Specify Microsoft.Graph as the module name.\\\"}],\\\"solution\\\":\\\"Import-Module -Name Microsoft.Graph\\\",\\\"explanation\\\":\\\"Import-Module explicitly loads a module and all its commands into the current session. This is useful at the top of scripts to ensure dependencies are available.\\\"},{\\\"id\\\":\\\"m1-l9-ex5\\\",\\\"type\\\":\\\"syntax-check\\\",\\\"prompt\\\":\\\"Write a command to show all installed versions of the 'Az' module on your system, displaying the Name and Version properties.\\\",\\\"hints\\\":[\\\"Use Get-Module with -ListAvailable to see installed modules.\\\",\\\"Specify -Name Az to filter to just that module.\\\",\\\"Pipe to Select-Object to pick the Name and Version properties.\\\"],\\\"validation\\\":[{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Get-Module\\\",\\\"hintOnFail\\\":\\\"Use Get-Module to find installed modules.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"-ListAvailable\\\",\\\"hintOnFail\\\":\\\"Add -ListAvailable to see all installed modules, not just loaded ones.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"-Name\\\\\\\\s+['\\\\\\\"]?Az['\\\\\\\"]?\\\",\\\"hintOnFail\\\":\\\"Filter by module name Az using the -Name parameter.\\\"},{\\\"rule\\\":\\\"contains\\\",\\\"value\\\":\\\"Select-Object\\\",\\\"hintOnFail\\\":\\\"Pipe to Select-Object to display specific properties.\\\"},{\\\"rule\\\":\\\"structure\\\",\\\"check\\\":\\\"has-pipeline\\\",\\\"hintOnFail\\\":\\\"Use the pipeline | to connect Get-Module to Select-Object.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"Name\\\",\\\"hintOnFail\\\":\\\"Include the Name property in Select-Object.\\\"},{\\\"rule\\\":\\\"regex\\\",\\\"pattern\\\":\\\"Version\\\",\\\"hintOnFail\\\":\\\"Include the Version property in Select-Object.\\\"}],\\\"solution\\\":\\\"Get-Module -Name Az -ListAvailable | Select-Object Name, Version\\\",\\\"explanation\\\":\\\"Get-Module -ListAvailable shows all installed versions of a module. Piping to Select-Object Name, Version gives a clean summary of what is available on your system.\\\"}],\\\"moduleSlug\\\":\\\"fundamentals\\\"}}],\\\"$L12\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"12:[\\\"$\\\",\\\"footer\\\",null,{\\\"className\\\":\\\"border-t border-zinc-800/60\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto flex max-w-4xl items-center justify-between px-6 py-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\