ints\":[\"Start with Get-Service and pipe to Group-Object.\",\"Group-Object takes a property name as its argument.\",\"Try: Get-Service | Group-Object Status\"],\"validation\":[{\"rule\":\"contains\",\"value\":\"Get-Service\",\"hintOnFail\":\"Start with Get-Service.\"},{\"rule\":\"contains\",\"value\":\"|\",\"hintOnFail\":\"Use the pipe operator |.\"},{\"rule\":\"contains\",\"value\":\"Group-Object\",\"hintOnFail\":\"Use Group-Object to group items.\"},{\"rule\":\"contains\",\"value\":\"Status\",\"hintOnFail\":\"Group by the Status property.\"}],\"solution\":\"Get-Service | Group-Object Status\",\"explanation\":\"Group-Object clusters the service objects by their Status property, showing you a count of how many services are Running, Stopped, etc.\"},{\"id\":\"m2-l1-ex4\",\"type\":\"syntax-check\",\"prompt\":\"Write a pipeline that uses Measure-Object to calculate the sum of the Length property for all files in the current directory (use Get-ChildItem).\",\"hints\":[\"Get-ChildItem lists items in the current directory.\",\"Pipe to Measure-Object with -Property Length and -Sum.\",\"Try: Get-ChildItem | Measure-Object -Property Length -Sum\"],\"validation\":[{\"rule\":\"contains\",\"value\":\"Get-ChildItem\",\"hintOnFail\":\"Use Get-ChildItem to list files.\"},{\"rule\":\"contains\",\"value\":\"Measure-Object\",\"hintOnFail\":\"Pipe to Measure-Object to perform calculations.\"},{\"rule\":\"contains\",\"value\":\"-Property\",\"hintOnFail\":\"Use -Property to specify which property to measure.\"},{\"rule\":\"contains\",\"value\":\"Length\",\"hintOnFail\":\"Measure the Length property for file sizes.\"},{\"rule\":\"contains\",\"value\":\"-Sum\",\"hintOnFail\":\"Use -Sum to calculate the total.\"}],\"solution\":\"Get-ChildItem | Measure-Object -Property Length -Sum\",\"explanation\":\"This pipeline gets all items in the current directory and calculates the sum of their Length (file size) property using Measure-Object.\"},{\"id\":\"m2-l1-ex5\",\"type\":\"syntax-check\",\"pr