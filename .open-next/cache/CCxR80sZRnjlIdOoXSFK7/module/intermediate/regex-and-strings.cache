n the first line and 'Welcome aboard.' on the second line. Assume $name is already defined.\",\"hints\":[\"A double-quoted here-string starts with @\\\" on its own line.\",\"The content goes on the lines between the delimiters.\",\"It ends with \\\"@ at the very beginning of a new line.\"],\"validation\":[{\"rule\":\"regex\",\"pattern\":\"@\\\"\",\"hintOnFail\":\"Start the here-string with @\\\" on its own line.\"},{\"rule\":\"contains\",\"value\":\"$$name\",\"hintOnFail\":\"Include $name in the here-string so it gets expanded.\"},{\"rule\":\"regex\",\"pattern\":\"\\\"@\",\"hintOnFail\":\"End the here-string with \\\"@ at the start of a new line.\"},{\"rule\":\"contains\",\"value\":\"Welcome aboard\",\"hintOnFail\":\"Include 'Welcome aboard.' on the second line.\"}],\"solution\":\"@\\\"\\nHello, $name!\\nWelcome aboard.\\n\\\"@\",\"explanation\":\"The @\\\" delimiter starts an expandable here-string. Variables like $name are expanded. The closing \\\"@ must appear at the beginning of its own line.\"}],\"moduleSlug\":\"intermediate\"}}],\"$L5\"]}],[\"$L6\"],\"$L7\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"CCxR80sZRnjlIdOoXSFK7\"}\n5:[\"$\",\"footer\",null,{\"className\":\"border-t border-zinc-800/60\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto flex max-w-4xl items-center justify-between px-6 py-6\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/module/intermediate/pipeline-in-depth\",\"className\":\"group flex items-center gap-2 text-sm text-zinc-400 transition-colors hover:text-zinc-200\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 transition-transform group-hover:-translate-x-0.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"strokeWidth\":2,\"stroke\":\"currentColor\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18\"}]}],\"The Pipeline in Depth\"]}],[\"$\",\"$L2\",null,{\"href\":\"/module/intermediate/rest-apis\",